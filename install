#!/bin/bash
# ============================================================
#  NiiX Arch Installer  //  niixa.org
#  Modes   : Dual-boot (Arch + Windows)  |  Single-boot (bare drive)
#  Stack   : LUKS2 - Btrfs - Limine - CachyOS - GNOME (customised)
#  Desktop : dash-to-panel + ArcMenu (clean desktop, no icons)
#  Extras  : Auto GPU drivers - Gaming (Steam/Lutris/Heroic) - Wi-Fi hotspot
#
#  Requirements:
#    - UEFI system (not legacy BIOS)
#    - Secure Boot OFF  (Limine does not support it)
#    - Dual-boot : free/unallocated space OR a deletable partition
#    - Single-boot : a drive you are willing to completely wipe
#    - Internet connection on the Arch live ISO
#
#  Hardcoded preferences:
#    Keyboard   : us / ch
#    Locale     : en_GB.UTF-8
#    Mirrors    : Switzerland
#    Desktop    : GNOME
#    Bootloader : Limine (UEFI)
#    Encryption : LUKS2
#    Filesystem : Btrfs  (@  @home  @snapshots  @var_log)
#    Kernel     : linux-cachyos (BORE scheduler, installed first-boot)
#    Swap       : ZRAM (zstd, auto-sized)
#
#  HOW TO RUN from the Arch ISO:
#    bash <(curl -fsSL https://niixa.org/install)
#  Before touching anything, the installer checks itself against the sha256
#  published separately on GitHub (techniixdotcom/niixarch-install) and
#  refuses to run on a mismatch. Strongest option - verify BEFORE running,
#  which a tampered download could not skip:
#    curl -fsSLo install https://niixa.org/install && curl -fsSL https://raw.githubusercontent.com/techniixdotcom/niixarch-install/main/install.sha256 | grep ' install$' | sha256sum -c && bash install
# ============================================================

set -uo pipefail

# -- Logging --------------------------------------------------
LOGFILE="/root/niixarch-install-$(date +%Y%m%d-%H%M%S).log"
exec > >(tee -a "$LOGFILE") 2>&1

# -- Colours - matched to niixa.org palette -------------
#   GREEN  = neon green  #0aff9e  (256-colour: 118)
#   PINK   = neon pink   #ff0a6c  (256-colour: 205)
GREEN='\033[38;5;118m'
PINK='\033[38;5;205m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
DIM='\033[2;37m'
BOLD='\033[1m'
NC='\033[0m'

# -- UI kit palette (real ESC, for the printf-based helpers below) --------------
# One look everywhere: white body text, green + pink accents. Red/amber are kept
# only for warnings and errors so failures stay visually distinct (safety).
C_GREEN=$'\033[38;5;118m'; C_PINK=$'\033[38;5;205m'; C_WHITE=$'\033[38;5;255m'
C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'; C_RED=$'\033[38;5;203m'; C_YEL=$'\033[38;5;215m'; C_NC=$'\033[0m'

# -- Hardcoded preferences ------------------------------------
KEYMAP="us"        # console keymap  (loadkeys / vconsole.conf) - set by gather_input
KEYMAP_X11="us"    # X11/Wayland layout (localectl / XkbLayout) - set by gather_input
KEYMAP_X11_VARIANT=""          # XkbVariant (e.g. dvorak) - set by gather_input
KEYBOARD_NAME="English (US)"   # human-readable, for the summary screen
LOCALE="en_GB.UTF-8"
MIRROR_COUNTRY="Switzerland"
MAPPER="cryptroot"
BTRFS_OPTS="noatime,compress=zstd,space_cache=v2"
NIIX_BUILD="2026-10-01-r30"  # bump on every change - printed on the banner to verify freshness

# -- Install mode ---------------------------------------------
INSTALL_MODE=""    # "dualboot" | "singleboot"
SINGLE_DRIVE=""    # target drive for single-boot (entire drive wiped)

# -- Detected at runtime --------------------------------------
EFI_PART=""
EFI_DRIVE=""
EFI_PART_NUM=""
TARGET_DRIVE=""
LUKS_PART=""
LUKS_UUID=""

# -- User input -----------------------------------------------
HOSTNAME=""; USERNAME=""; USER_PASS=""; LUKS_PASS=""; TIMEZONE=""
FREE_START=""; FREE_END=""
USE_MITIGATIONS=false

# -- Hardware (detected at runtime) ---------------------------
CPU_VENDOR=""; CPU_MODEL=""; GPU_VENDOR=""; GPU_MODEL=""; GPU_GEN=""; NVIDIA_LEGACY=""
HAS_NVIDIA=0; HAS_AMD=0; HAS_INTEL=0; GPU_COUNT=0; IS_HYBRID=false; OFFLOAD_MODE=""
DGPU_PCI=""; DRI_PRIME_TAG="1"
MEM_TOTAL_GB=0; HAS_NVME=false; HAS_SSD=false

# -- Output helpers ------------------------------------------
# -- UI kit : titles, status lines, live % bar, spinner (one consistent look) ---
# Animations draw straight to the terminal so their \r redraws never pollute the
# tee'd log; full command output is archived to the log while the screen stays
# tidy. Falls back to stdout when there is no controlling terminal.
if { exec 3>/dev/tty; } 2>/dev/null; then :; else exec 3>&1; fi
ui_hr()    { printf '  %s────────────────────────────────────────────────%s\n' "$C_GREEN" "$C_NC"; }
ui_title() { printf '\n  %s▸%s  %s%s%s\n' "$C_PINK" "$C_NC" "$C_BOLD$C_WHITE" "$*" "$C_NC"; ui_hr; }
ui_ok()    { printf '  %s✔%s  %s%s%s\n' "$C_GREEN" "$C_NC" "$C_WHITE" "$*" "$C_NC"; }
ui_info()  { printf '  %s•%s  %s%s%s\n' "$C_PINK"  "$C_NC" "$C_WHITE" "$*" "$C_NC"; }
ui_warn()  { printf '  %s!%s  %s%s%s\n' "$C_YEL"   "$C_NC" "$C_WHITE" "$*" "$C_NC"; }

# ui_bar CURRENT TOTAL [label] : redraw a themed percentage bar in place.
ui_bar() {
    local cur=$1 tot=$2 label=${3:-} width=28 i fill pct done_="" todo_=""
    [ "$tot" -gt 0 ] 2>/dev/null || tot=1
    [ "$cur" -gt "$tot" ] 2>/dev/null && cur=$tot
    pct=$(( cur * 100 / tot )); fill=$(( cur * width / tot ))
    for ((i=0;i<fill;i++)); do done_+='█'; done
    for ((i=fill;i<width;i++)); do todo_+='░'; done
    printf '\r  %s[%s%s%s%s%s]%s %s%3d%%%s  %s%s%s' \
        "$C_PINK" "$C_GREEN" "$done_" "$C_DIM" "$todo_" "$C_NC" "$C_PINK" \
        "$C_WHITE" "$pct" "$C_NC" "$C_DIM" "$label" "$C_NC" >&3
    [ "$cur" -ge "$tot" ] && printf '\n' >&3
}

# ui_run "Message" cmd args... : animate while cmd runs, archive its output to
# the log, print a ✔/! summary, and return cmd's real exit code.
ui_run() {
    local msg=$1; shift
    local frames='|/-\' i=0 start el rc pid
    "$@" >>"${LOGFILE:-/dev/null}" 2>&1 &
    pid=$!; start=$SECONDS
    while kill -0 "$pid" 2>/dev/null; do
        i=$(( (i+1) % 4 )); el=$(( SECONDS - start ))
        printf '\r  %s%s%s  %s%s%s %s(%ds)%s   ' \
            "$C_PINK" "${frames:i:1}" "$C_NC" "$C_WHITE" "$msg" "$C_NC" "$C_DIM" "$el" "$C_NC" >&3
        sleep 0.1
    done
    wait "$pid"; rc=$?; el=$(( SECONDS - start ))
    printf '\r\033[K' >&3
    if [ "$rc" -eq 0 ]; then ui_ok "$msg  ${C_DIM}(${el}s)${C_NC}"
    else ui_warn "$msg  ${C_DIM}(failed rc=$rc, ${el}s - see log)${C_NC}"; fi
    return "$rc"
}

log()  { ui_ok "$@"; }
warn() { ui_warn "$@"; }
err()  {
    printf '\n  %s✗%s  %sERROR%s  %s%s%s\n' "$C_RED" "$C_NC" "$C_RED" "$C_NC" "$C_WHITE" "$*" "$C_NC"
    dump_state "ERROR: $*" 2>/dev/null || true
    ui_info "Log saved to: ${LOGFILE}"
    # Offer to copy logs to USB BEFORE unmounting - this is exactly the
    # moment logs matter most, and /mnt/var/log/niixarch-install.log (if it
    # exists yet) is only readable while /mnt is still mounted.
    copy_logs_to_usb 2>/dev/null || true
    # Leave a clean slate: no half-open LUKS container or dangling /mnt mounts.
    swapoff -a 2>/dev/null || true
    umount -R /mnt 2>/dev/null || true
    cryptsetup close "$MAPPER" 2>/dev/null || true
    exit 1
}

# Signal handler: on Ctrl+C / kill during install, unwind mounts + encryption so the
# machine is never left in a half-installed state. Reset before the final reboot
# prompt so Ctrl+C there still drops the user to a shell with /mnt intact.
cleanup_on_fail() {
    trap - INT TERM
    echo
    warn "Interrupted - cleaning up (unmounting target, closing encryption)..."
    copy_logs_to_usb 2>/dev/null || true
    swapoff -a 2>/dev/null || true
    umount -R /mnt 2>/dev/null || true
    cryptsetup close "$MAPPER" 2>/dev/null || true
    exit 130
}
info() { ui_info "$@"; }
ask()  { printf '\n  %s?%s  %s%s%s ' "$C_PINK" "$C_NC" "$C_BOLD$C_WHITE" "$*" "$C_NC"; }

# Styled section header - called as: hr "Section Title" (or hr for a plain rule)
hr() {
    if [[ -n "${1:-}" ]]; then ui_title "$1"; else printf '\n'; ui_hr; printf '\n'; fi
}

# Debug helper - writes ONLY to log file, not to screen
dbg() {
    echo "[DBG $(date +%H:%M:%S)] $*" >> "$LOGFILE"
}

# Dump system state to log for troubleshooting
dump_state() {
    local label="$1"
    {
        echo ""
        echo "================================================"
        echo "  DEBUG DUMP: $label"
        echo "  $(date)"
        echo "================================================"
        echo ""
        echo "--- lsblk -f ---"
        lsblk -f 2>&1 || true
        echo ""
        echo "--- blkid ---"
        blkid 2>&1 || true
        echo ""
        echo "--- efibootmgr ---"
        efibootmgr -v 2>&1 || true
        echo ""
        echo "--- df -h (mounted) ---"
        df -h 2>&1 || true
        echo ""
        echo "--- mount ---"
        mount 2>&1 || true
        echo ""
        echo "--- Script variables ---"
        echo "EFI_PART=$EFI_PART"
        echo "EFI_DRIVE=$EFI_DRIVE"
        echo "EFI_PART_NUM=$EFI_PART_NUM"
        echo "TARGET_DRIVE=$TARGET_DRIVE"
        echo "LUKS_PART=$LUKS_PART"
        echo "LUKS_UUID=$LUKS_UUID"
        echo "FREE_START=${FREE_START:-}"
        echo "FREE_END=${FREE_END:-}"
        echo "MAPPER=$MAPPER"
        echo ""
        echo "================================================"
        echo ""
    } >> "$LOGFILE" 2>&1
}

# -- Copy logs to USB drive ----------------------------------
# Moved up from near the end of the script so err() can call this too - it
# was previously only wired into the successful-completion path at the very
# bottom, so on ANY install failure (the moment you most want your logs
# saved somewhere durable) it never ran at all.
copy_logs_to_usb() {
    hr "Save Logs to USB"
    info "Looking for a USB drive to copy logs to..."

    # Find which drive is running the live ISO - exclude it
    ISO_DEV=""
    # Try multiple archiso mount points
    for mnt in /run/archiso/bootmnt /run/archiso/airootfs; do
        src=$(findmnt -n -o SOURCE "$mnt" 2>/dev/null | head -1)
        if [[ -n "$src" ]]; then
            parent=$(lsblk -no PKNAME "$src" 2>/dev/null | head -1)
            # Handle nested parents (e.g. ventoy -> sda1 -> sda)
            while [[ -n "$parent" ]]; do
                grandparent=$(lsblk -no PKNAME "/dev/$parent" 2>/dev/null | head -1)
                [[ -n "$grandparent" ]] && parent="$grandparent" || break
            done
            [[ -n "$parent" ]] && ISO_DEV="/dev/$parent" && break
        fi
    done
    dbg "ISO drive: ${ISO_DEV:-unknown}"

    # Find USB/removable drives that are NOT the ISO drive
    USB_PARTS=()

    # First, find all USB or removable DISKS
    USB_DISKS=()
    while IFS= read -r line; do
        dpath=$(echo "$line" | awk '{print $1}')
        drm=$(echo "$line" | awk '{print $3}')
        dtran=$(echo "$line" | awk '{print $4}')
        # Include if removable OR USB transport
        if [[ "$drm" == "1" || "$dtran" == "usb" ]]; then
            [[ "$dpath" == "$ISO_DEV" ]] && continue
            USB_DISKS+=("$dpath")
        fi
    done < <(lsblk -dn -o PATH,TYPE,RM,TRAN 2>/dev/null | awk '$2 == "disk"')

    dbg "USB disks (excluding ISO): ${USB_DISKS[*]+"${USB_DISKS[*]}"}"

    # Now find mountable partitions on those USB disks
    if [[ ${#USB_DISKS[@]} -gt 0 ]]; then
        for udisk in "${USB_DISKS[@]}"; do
        while IFS= read -r pdev; do
            [[ -b "$pdev" ]] || continue
            fstype=$(lsblk -no FSTYPE "$pdev" 2>/dev/null | head -1)
            [[ -z "$fstype" ]] && continue

            size=$(lsblk -no SIZE "$pdev" 2>/dev/null | head -1)
            label=$(lsblk -no LABEL "$pdev" 2>/dev/null | head -1)
            label=${label:-no label}

            USB_PARTS+=("${pdev}|${size}|${fstype}|${label}")
        done < <(lsblk -ln -o PATH,TYPE "$udisk" 2>/dev/null | awk '$2 == "part" {print $1}')
        done
    fi

    if [[ ${#USB_PARTS[@]} -eq 0 ]]; then
        warn "No other USB drive found. Logs saved to:"
        echo -e "    ${YELLOW}${LOGFILE}${NC}  (live ISO - lost on reboot)"
        echo -e "    ${YELLOW}/var/log/niixarch-install.log${NC}  (installed system)"
        return
    fi

    # Pick the USB partition
    local USB_TARGET=""
    if [[ ${#USB_PARTS[@]} -eq 1 ]]; then
        USB_TARGET="${USB_PARTS[0]}"
        IFS='|' read -r udev usize ufs ulabel <<< "$USB_TARGET"
        log "Found USB: $udev ($usize, $ufs, $ulabel)"
    else
        echo
        echo -e "${BOLD}  Multiple USB partitions found:${NC}"
        echo
        for i in "${!USB_PARTS[@]}"; do
            IFS='|' read -r udev usize ufs ulabel <<< "${USB_PARTS[$i]}"
            printf "  ${CYAN}[%s]${NC}  %-16s  %6s  %s  (%s)\n" \
                "$i" "$udev" "$usize" "$ulabel" "$ufs"
        done
        echo
        ask "Copy logs to which USB? Enter the number (or 's' to skip):"
        read -rp "  > " USB_CHOICE
        [[ "$USB_CHOICE" == "s" ]] && { info "Skipped."; return; }
        [[ "$USB_CHOICE" =~ ^[0-9]+$ ]] || { warn "Invalid choice. Skipped."; return; }
        USB_TARGET="${USB_PARTS[$USB_CHOICE]:-}"
        [[ -n "$USB_TARGET" ]] || { warn "Invalid choice. Skipped."; return; }
    fi

    IFS='|' read -r USB_DEV _ _ USB_LABEL <<< "$USB_TARGET"

    # Mount the USB
    local USB_MNT="/mnt_usb_log"
    mkdir -p "$USB_MNT"

    if mount "$USB_DEV" "$USB_MNT" 2>/dev/null; then
        log "Mounted $USB_DEV at $USB_MNT"

        # Copy both log files (the installed-system copy may not exist yet if
        # we're being called from err() before configure_system ran)
        cp "$LOGFILE" "$USB_MNT/" 2>/dev/null \
            && log "Copied $(basename "$LOGFILE") to USB"
        cp /mnt/var/log/niixarch-install.log "$USB_MNT/" 2>/dev/null \
            && log "Copied niixarch-install.log to USB"
        cp /root/niixarch-luks-header-backup.img "$USB_MNT/" 2>/dev/null \
            && log "Copied LUKS header backup to USB"

        sync
        umount "$USB_MNT" 2>/dev/null
        rmdir "$USB_MNT" 2>/dev/null || true

        log "Logs saved to USB ($USB_LABEL)"
    else
        warn "Could not mount $USB_DEV - logs not copied to USB"
    fi
}

# Returns 0 if a drive is removable (USB) or virtual (loop/ram/dm), 1 if internal physical
is_removable() {
    local dev
    dev=$(basename "$1")
    # Exclude loop devices, RAM disks, and device-mapper - these are never install targets
    [[ "$dev" == loop*  ]] && return 0
    [[ "$dev" == ram*   ]] && return 0
    [[ "$dev" == dm-*   ]] && return 0
    local rm_flag
    rm_flag=$(cat "/sys/block/${dev}/removable" 2>/dev/null || echo "0")
    [[ "$rm_flag" == "1" ]] && return 0
    # Also check transport - USB drives may report RM=0
    local tran
    tran=$(lsblk -dn -o TRAN "/dev/$dev" 2>/dev/null | tr -d '[:space:]')
    [[ "$tran" == "usb" ]] && return 0
    return 1
}

banner() {
    clear 2>/dev/null || true
    local g="$C_GREEN" p="$C_PINK" n="$C_NC" w="$C_WHITE" d="$C_DIM" b="$C_BOLD" r="$C_RED"
    printf '\n'
    printf '  %s███╗   ██╗██╗██╗██╗  ██╗ █████╗ %s██████╗ ███████╗%s\n' "$g" "$p" "$n"
    printf '  %s████╗  ██║██║██║╚██╗██╔╝██╔══██╗%s██╔═══██╗██╔════╝%s\n' "$g" "$p" "$n"
    printf '  %s██╔██╗ ██║██║██║ ╚███╔╝ ███████║%s██║   ██║███████╗%s\n' "$g" "$p" "$n"
    printf '  %s██║╚██╗██║██║██║ ██╔██╗ ██╔══██║%s██║   ██║╚════██║%s\n' "$g" "$p" "$n"
    printf '  %s██║ ╚████║██║██║██╔╝ ██╗██║  ██║%s╚██████╔╝███████║%s\n' "$g" "$p" "$n"
    printf '  %s╚═╝  ╚═══╝╚═╝╚═╝╚═╝  ╚═╝╚═╝  ╚═╝%s ╚═════╝ ╚══════╝%s\n' "$g" "$p" "$n"
    printf '\n'
    printf '  %s%sArch Installer%s   %sluks2 · cachyos · limine · btrfs · gnome%s\n' "$b" "$w" "$n" "$d" "$n"
    printf '  %sbuild %s%s   %s(missing/old? you are running a stale script)%s\n' "$g" "${NIIX_BUILD:-?}" "$n" "$d" "$n"
    ui_hr
    printf '\n'
    printf '  %s▸%s  %s%sRequired before running%s\n' "$p" "$n" "$b" "$w" "$n"
    printf '  %s✗%s  %sSecure Boot must be OFF in BIOS%s\n' "$r" "$n" "$w" "$n"
    printf '  %s✗%s  %sLimine does not support Secure Boot%s\n' "$r" "$n" "$w" "$n"
    printf '\n'
}

# -- Hardware detection (runs from live ISO) ------------------
detect_hardware() {
    hr "Hardware Detection"
    info "Detecting hardware..."

    # CPU
    CPU_MODEL=$(grep -m1 "model name" /proc/cpuinfo | cut -d: -f2 | xargs)
    if grep -qi "AuthenticAMD" /proc/cpuinfo; then
        CPU_VENDOR="amd"
    elif grep -qi "GenuineIntel" /proc/cpuinfo; then
        CPU_VENDOR="intel"
    else
        CPU_VENDOR="unknown"
    fi
    log "CPU: $CPU_MODEL ($CPU_VENDOR)"

    # GPU - detect via lspci descriptions. Count every GPU so hybrid (iGPU + dGPU)
    # laptops are handled correctly, not just the "primary" card.
    GPU_DESCS=$(lspci 2>/dev/null | grep -iE "VGA|3D|Display" | sed 's/.*: //')
    GPU_COUNT=$(lspci 2>/dev/null | grep -ciE "VGA compatible controller|3D controller|Display controller")
    HAS_NVIDIA=$(echo "$GPU_DESCS" | grep -ciE "NVIDIA" || true)
    HAS_AMD=$(echo "$GPU_DESCS" | grep -ciE "\bAMD\b|\bATI\b|\bRadeon\b|Advanced Micro" || true)
    HAS_INTEL=$(echo "$GPU_DESCS" | grep -ciE "Intel" || true)
    local has_nvidia="$HAS_NVIDIA" has_amd="$HAS_AMD" has_intel="$HAS_INTEL"

    if [[ "$has_nvidia" -gt 0 ]]; then
        GPU_VENDOR="nvidia"
        GPU_MODEL=$(echo "$GPU_DESCS" | grep -iE "NVIDIA" | head -1)
        # Classify the architecture (codename first, marketing name as fallback).
        # This decides the driver: NVIDIA's mainline driver (R590+, Dec 2025) supports
        # only Turing and newer; Maxwell/Pascal/Kepler need a legacy AUR branch.
        if echo "$GPU_MODEL" | grep -qiE "TU[0-9]{3}|GA[0-9]{3}|AD[0-9]{3}|GB[0-9]{3}|GH[0-9]{3}|RTX [0-9]|GTX 16[0-9]{2}"; then
            GPU_GEN="turing_plus"; NVIDIA_LEGACY=""
        elif echo "$GPU_MODEL" | grep -qiE "GM[0-9]{3}|GP[0-9]{3}|GTX 9[0-9]{2}|GTX 10[0-9]{2}|TITAN X"; then
            GPU_GEN="maxwell_pascal"; NVIDIA_LEGACY="580xx"
        elif echo "$GPU_MODEL" | grep -qiE "GK[0-9]{3}|GTX 6[0-9]{2}|GTX 7[0-9]{2}"; then
            GPU_GEN="kepler"; NVIDIA_LEGACY="470xx"
        elif echo "$GPU_MODEL" | grep -qiE "GF[0-9]{3}|GTX [45][0-9]{2}"; then
            GPU_GEN="fermi"; NVIDIA_LEGACY=""
        else
            GPU_GEN="turing_plus"; NVIDIA_LEGACY=""   # unknown -> assume modern
        fi
    elif [[ "$has_amd" -gt 0 ]]; then
        GPU_VENDOR="amd"
        GPU_MODEL=$(echo "$GPU_DESCS" | grep -iE "\bAMD\b|\bATI\b|\bRadeon\b|Advanced Micro" | head -1)
        if echo "$GPU_MODEL" | grep -qiE "RX 9[0-9]{3}"; then GPU_GEN="rdna4"
        elif echo "$GPU_MODEL" | grep -qiE "RX 7[0-9]{3}"; then GPU_GEN="rdna3"
        elif echo "$GPU_MODEL" | grep -qiE "RX 6[0-9]{3}"; then GPU_GEN="rdna2"
        else GPU_GEN="older"; fi
    elif [[ "$has_intel" -gt 0 ]]; then
        GPU_VENDOR="intel"
        GPU_MODEL=$(echo "$GPU_DESCS" | grep -iE "Intel" | head -1)
    fi

    # Discrete ("most powerful") GPU + how games reach it. iGPUs sit on PCI bus 00
    # (Intel 00:02.0, AMD APU 00:01/00:08); a dGPU has its own bus (01:00, 03:00...).
    # Record the dGPU's PCI address so the Mesa offload path can target it
    # deterministically with DRI_PRIME=pci-DOMAIN_BUS_DEV_FN, which is far more
    # reliable than the ordinal DRI_PRIME=1 on multi-GPU boxes.
    DGPU_PCI=""
    local _gline _gaddr _gbus
    while IFS= read -r _gline; do
        [ -n "$_gline" ] || continue
        _gaddr=$(awk '{print $1}' <<< "$_gline")
        _gbus=$(cut -d: -f2 <<< "$_gaddr")
        if echo "$_gline" | grep -qiE "NVIDIA"; then
            DGPU_PCI="$_gaddr"; break                 # NVIDIA is always the discrete GPU
        elif [ "$_gbus" != "00" ] && [ -z "$DGPU_PCI" ]; then
            DGPU_PCI="$_gaddr"                         # a GPU off bus 00 == discrete
        fi
    done < <(lspci -D 2>/dev/null | grep -iE "VGA compatible controller|3D controller|Display controller")

    # Bias toward "hybrid" when unsure: treating a single-GPU box as hybrid is
    # harmless (the offload keys are ignored), whereas forcing a hybrid box to
    # single-GPU breaks the iGPU display.
    [[ "${GPU_COUNT:-0}" -ge 2 ]] && IS_HYBRID=true || IS_HYBRID=false
    if [[ "$IS_HYBRID" == true ]]; then
        if [[ "$has_nvidia" -gt 0 ]]; then OFFLOAD_MODE="nvidia"; else OFFLOAD_MODE="dri-prime"; fi
    fi
    # Deterministic DRI_PRIME target for the Mesa (AMD/Intel dGPU) offload path.
    DRI_PRIME_TAG="1"
    [ -n "$DGPU_PCI" ] && DRI_PRIME_TAG="pci-${DGPU_PCI//[:.]/_}"
    log "GPU: $GPU_MODEL ($GPU_VENDOR${GPU_GEN:+ $GPU_GEN})"
    [[ "$IS_HYBRID" == true ]] && log "Hybrid graphics: $GPU_COUNT GPUs - games will offload to the dGPU ($OFFLOAD_MODE)"

    [[ "$GPU_VENDOR" == "unknown" || -z "$GPU_VENDOR" ]] \
        && warn "Could not detect GPU - drivers will need manual install"

    # RAM
    local mem_kb
    mem_kb=$(grep MemTotal /proc/meminfo | awk '{print $2}')
    MEM_TOTAL_GB=$(( mem_kb / 1024 / 1024 ))
    log "RAM: ~${MEM_TOTAL_GB}GB"

    # Storage type
    lsblk -d -o name,rota 2>/dev/null | grep -q "^nvme" && HAS_NVME=true
    lsblk -d -o name,rota 2>/dev/null | grep -q " 0$" && HAS_SSD=true
    log "Storage: NVMe=$HAS_NVME SSD=$HAS_SSD"
}

# -- WiFi connection - used by pre-flight when there's no link yet -----
# Works on both the official Arch ISO (iwd/iwctl) and the NiiX ISO
# (NetworkManager/nmcli). Interactive: scans, asks for SSID + password,
# connects, and verifies real internet before returning.
connect_wifi() {
    command -v rfkill &>/dev/null && rfkill unblock wifi 2>/dev/null || true

    local wifi_if d
    wifi_if=$(iw dev 2>/dev/null | awk '/Interface/{print $2; exit}')
    if [ -z "$wifi_if" ]; then
        for d in /sys/class/net/wl*; do [ -e "$d" ] && { wifi_if=$(basename "$d"); break; }; done
    fi
    if [ -z "$wifi_if" ]; then
        warn "No WiFi adapter detected."
        return 1
    fi

    local backend=""
    if command -v nmcli &>/dev/null; then
        systemctl is-active --quiet NetworkManager 2>/dev/null || systemctl start NetworkManager 2>/dev/null || true
        systemctl is-active --quiet NetworkManager 2>/dev/null && backend="nm"
    fi
    if [ -z "$backend" ] && command -v iwctl &>/dev/null; then
        systemctl start iwd 2>/dev/null || true
        backend="iwd"
    fi
    if [ -z "$backend" ]; then
        warn "No WiFi tool available (need nmcli or iwctl)."
        return 1
    fi

    info "WiFi adapter: $wifi_if  -  backend: $backend"

    local ssid wpass ok i again
    while true; do
        echo
        info "Scanning for networks..."
        if [ "$backend" = "nm" ]; then
            nmcli device wifi rescan ifname "$wifi_if" 2>/dev/null || nmcli device wifi rescan 2>/dev/null || true
            sleep 3
            nmcli -t -f SSID,SIGNAL,SECURITY device wifi list 2>/dev/null \
                | awk -F: 'length($1){printf "     %-32s  %3s%%  %s\n",$1,$2,($3==""?"open":$3)}' \
                | sort -u | head -25
        else
            iwctl station "$wifi_if" scan 2>/dev/null || true
            sleep 3
            iwctl station "$wifi_if" get-networks 2>/dev/null \
                | sed -e 's/\x1b\[[0-9;]*m//g' | awk 'NR>4 && NF{print "     "$0}' | head -25
        fi

        echo
        read -rp "  WiFi network name (SSID) - or 'skip' to cancel: " ssid
        if [ -z "$ssid" ]; then continue; fi
        if [ "$ssid" = "skip" ]; then warn "WiFi setup skipped."; return 1; fi
        read -rsp "  WiFi password (leave blank if open): " wpass; echo

        info "Connecting to '$ssid'..."
        if [ "$backend" = "nm" ]; then
            if [ -n "$wpass" ]; then
                nmcli device wifi connect "$ssid" password "$wpass" ifname "$wifi_if" 2>&1 | sed 's/^/     /'
            else
                nmcli device wifi connect "$ssid" ifname "$wifi_if" 2>&1 | sed 's/^/     /'
            fi
        else
            if [ -n "$wpass" ]; then
                iwctl --passphrase "$wpass" station "$wifi_if" connect "$ssid" 2>&1 | sed 's/^/     /'
            else
                iwctl station "$wifi_if" connect "$ssid" 2>&1 | sed 's/^/     /'
            fi
        fi

        ok=false
        for i in 1 2 3 4 5; do
            ping -c1 -W3 archlinux.org &>/dev/null && { ok=true; break; }
            sleep 2
        done
        if $ok; then
            log "Connected to '$ssid' - internet is up"
            return 0
        fi

        warn "Still no internet on '$ssid' (wrong password, weak signal, or captive portal?)."
        read -rp "  Try a different network / retry? [Y/n]: " again
        case "${again,,}" in n|no) warn "WiFi setup cancelled."; return 1 ;; esac
    done
}

# -- Ensure internet, bringing up WiFi if there's no active link ------
ensure_internet() {
    info "Checking internet connection..."
    local i
    for i in 1 2 3; do
        if ping -c1 -W3 archlinux.org &>/dev/null; then
            log "Internet connection detected"
            return 0
        fi
        sleep 2
    done

    warn "No wired/active connection found - let's set up WiFi."
    connect_wifi && return 0
    err "No internet connection. Connect Ethernet or WiFi, then re-run the installer."
}

# -- Step 0: Pre-flight checks --------------------------------
check_prereqs() {
    hr "Pre-flight Checks"
    info "Running pre-flight checks..."

    [ "$EUID" -eq 0 ]        || err "Please run as root"

    ensure_internet

    [ -d /sys/firmware/efi ] || err "Not booted in UEFI mode - enable UEFI in BIOS"

    # Secure Boot must be OFF - Limine doesn't support it. Fail now with a
    # clear message rather than a confusing boot failure after a full install.
    if command -v mokutil &>/dev/null; then
        if mokutil --sb-state 2>/dev/null | grep -qi "SecureBoot enabled"; then
            err "Secure Boot is ON - disable it in BIOS/UEFI settings, then re-run this installer (Limine does not support Secure Boot)"
        fi
    elif [[ -d /sys/firmware/efi/efivars ]]; then
        local sb_var
        sb_var=$(find /sys/firmware/efi/efivars -maxdepth 1 -name 'SecureBoot-*' 2>/dev/null | head -1)
        if [[ -n "$sb_var" ]]; then
            local sb_byte
            sb_byte=$(od -An -tu1 "$sb_var" 2>/dev/null | awk '{print $NF}')
            [[ "$sb_byte" == "1" ]] && err "Secure Boot is ON - disable it in BIOS/UEFI settings, then re-run this installer (Limine does not support Secure Boot)"
        fi
    fi

    for cmd in cryptsetup parted mkfs.btrfs python3 efibootmgr lsblk blkid; do
        command -v "$cmd" &>/dev/null || err "$cmd not found on live ISO"
    done

    loadkeys "$KEYMAP"   # load default (us) until user selects layout in gather_input
    log "Keyboard: $KEYMAP (default - will be updated after layout selection)"
    log "All checks passed"
}

# -- Step 1: Auto-detect EFI partition (internal drives only) -
detect_efi() {
    hr "EFI Partition Detection"
    info "Detecting EFI System Partition..."

    # Primary: match EFI System Partition GUID, skip USB drives
    while IFS= read -r dev; do
        [[ -b "$dev" ]] || continue
        parent=$(lsblk -no PKNAME "$dev" 2>/dev/null)
        if [[ -n "$parent" ]] && is_removable "/dev/$parent"; then
            continue
        fi
        EFI_PART="$dev"
        break
    done < <(blkid -t PART_ENTRY_TYPE="c12a7328-f81f-11d2-ba4b-00a0c93ec93b" \
                   -o device 2>/dev/null)

    # Fallback: find FAT32 partition with esp flag on internal drives
    if [[ -z "$EFI_PART" ]]; then
        while IFS= read -r drive; do
            [[ -b "$drive" ]] || continue
            is_removable "$drive" && continue
            partnum=$(parted -m "$drive" print 2>/dev/null \
                | awk -F: '$7 ~ /esp/ || $7 ~ /boot/ {print $1; exit}')
            if [[ -n "$partnum" ]]; then
                if [[ "$drive" == *nvme* || "$drive" == *mmcblk* ]]; then
                    EFI_PART="${drive}p${partnum}"
                else
                    EFI_PART="${drive}${partnum}"
                fi
                break
            fi
        done < <(lsblk -dn -o PATH 2>/dev/null)
    fi

    [[ -n "$EFI_PART" && -b "$EFI_PART" ]] \
        || err "Could not find EFI System Partition on any internal drive."

    EFI_DRIVE_NAME=$(lsblk -no PKNAME "$EFI_PART" 2>/dev/null)
    EFI_DRIVE="/dev/$EFI_DRIVE_NAME"
    EFI_PART_NUM=$(lsblk -no PARTN "$EFI_PART" 2>/dev/null \
        || echo "$EFI_PART" | grep -o '[0-9]*$')

    EFI_SIZE=$(lsblk -no SIZE "$EFI_PART" 2>/dev/null || echo "?")
    log "EFI partition : $EFI_PART  ($EFI_SIZE)"
    log "EFI drive     : $EFI_DRIVE  (partition $EFI_PART_NUM)"

    # Warn if EFI partition is small - kernels + initramfs need ~150 MiB
    EFI_SIZE_BYTES=$(lsblk -bno SIZE "$EFI_PART" 2>/dev/null | head -1 | tr -d '[:space:]')
    EFI_SIZE_BYTES=${EFI_SIZE_BYTES:-0}
    if [[ "$EFI_SIZE_BYTES" -lt 209715200 ]] 2>/dev/null; then   # < 200 MiB
        warn "EFI partition is only $EFI_SIZE - this may be too small"
        warn "for Linux kernels + initramfs. Consider resizing it first."
        ask "Continue anyway? (y/N):"
        read -rp "  > " efi_ok
        [[ "$efi_ok" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }
    fi
}

# -- Step 2: Find free space or offer partition deletion ----
detect_free_spaces() {
    hr "Free Space / Partition Selection"
    info "Scanning internal drives for free space (>10 GiB)..."
    echo

    FREE_SPACE_LIST=$(python3 <<'PYEOF'
import subprocess

# Get all disks - internal only (RM=0 and not USB transport)
try:
    raw = subprocess.check_output(
        ['lsblk', '-dn', '-o', 'PATH,TYPE,RM,TRAN'],
        stderr=subprocess.DEVNULL, text=True
    )
except Exception:
    raw = ""

drives = []
for line in raw.strip().split('\n'):
    cols = line.split()
    if len(cols) < 3:
        continue
    path, dtype, rm = cols[0], cols[1], cols[2]
    tran = cols[3] if len(cols) > 3 else ''
    if dtype != 'disk' or rm != '0':
        continue
    if tran.lower() == 'usb':
        continue
    drives.append(path)

entries = []
for drive in drives:
    try:
        model = subprocess.check_output(
            ['lsblk', '-dn', '-o', 'MODEL', drive],
            stderr=subprocess.DEVNULL, text=True
        ).strip() or "Unknown"

        # 5 second timeout - prevents hanging on odd drives
        out = subprocess.check_output(
            ['timeout', '5', 'parted', '-m', drive, 'unit', 'MiB', 'print', 'free'],
            stderr=subprocess.DEVNULL, text=True
        )

        for line in out.strip().split('\n'):
            parts = line.rstrip(';').split(':')
            if len(parts) >= 4 and 'free' in parts[-1].lower():
                try:
                    start = float(parts[1].replace('MiB', ''))
                    end   = float(parts[2].replace('MiB', ''))
                    size  = end - start
                    if size > 10240:  # > 10 GiB
                        entries.append(
                            f"{drive}|{start:.0f}|{end:.0f}|{size/1024:.1f}|{model}"
                        )
                except Exception:
                    pass
    except Exception:
        pass

for i, e in enumerate(entries):
    print(f"{i}:{e}")
PYEOF
)

    if [[ -n "$FREE_SPACE_LIST" ]]; then
        echo -e "  ${WHITE}${BOLD}Available free space regions:${NC}"
        echo
        while IFS= read -r line; do
            idx="${line%%:*}"
            rest="${line#*:}"
            IFS='|' read -r drive start _ size_gib model <<< "$rest"
            printf "  ${CYAN}[%s]${NC}  %-16s  %6.1f GiB  (%s)\n" \
                "$idx" "$drive" "$size_gib" "$model"
        done <<< "$FREE_SPACE_LIST"

        echo
        ask "Which region should Arch use? Enter the number:"
        read -rp "  > " CHOICE
        [[ "$CHOICE" =~ ^[0-9]+$ ]] || err "Invalid choice: $CHOICE"

        CHOSEN=$(echo "$FREE_SPACE_LIST" | grep "^${CHOICE}:")
        [[ -n "$CHOSEN" ]] || err "Invalid choice: $CHOICE"

        rest="${CHOSEN#*:}"
        IFS='|' read -r TARGET_DRIVE FREE_START FREE_END FREE_GiB FREE_MODEL <<< "$rest"

        log "Selected: $TARGET_DRIVE  (~${FREE_GiB} GiB)  [$FREE_MODEL]"
        return
    fi

    # -- No free space found - offer partition deletion ------
    warn "No free space (>10 GiB) found on any internal drive."
    info "You can delete an existing partition to make room."
    echo
    echo -e "  ${RED}${BOLD}  Protected partitions (will NOT be listed):${NC}"
    echo -e "    - EFI System Partition"
    echo -e "    - Windows / NTFS partitions"
    echo -e "    - Microsoft Reserved (MSR)"
    echo -e "    - Recovery partitions"
    echo

    # Build list of deletable partitions on internal drives
    PART_LIST=$(python3 - "$EFI_PART" "$LOGFILE" <<'PYEOF'
import subprocess, sys

efi_part = sys.argv[1]
logfile = sys.argv[2]

def log(msg):
    with open(logfile, 'a') as f:
        f.write(f"[PARTLIST] {msg}\n")

# Get internal, non-USB disks
try:
    raw = subprocess.check_output(
        ['lsblk', '-dn', '-o', 'PATH,TYPE,RM,TRAN'],
        stderr=subprocess.DEVNULL, text=True
    )
except Exception as e:
    log(f"ERROR getting drives: {e}")
    raw = ""

drives = []
for line in raw.strip().split('\n'):
    cols = line.split()
    if len(cols) < 3:
        continue
    path, dtype, rm = cols[0], cols[1], cols[2]
    tran = cols[3] if len(cols) > 3 else ''
    if dtype != 'disk' or rm != '0':
        log(f"Skip drive {path}: type={dtype} rm={rm}")
        continue
    if tran.lower() == 'usb':
        log(f"Skip drive {path}: USB transport")
        continue
    drives.append(path)
    log(f"Internal drive: {path} tran={tran}")

# Protected partition type GUIDs (lowercase)
protected_guids = {
    'c12a7328-f81f-11d2-ba4b-00a0c93ec93b',  # EFI System
    'e3c9e316-0b5c-4db8-817d-f92df00215ae',  # Microsoft Reserved (MSR)
    'de94bba4-06d1-4d40-a16a-bfd50179d6ac',  # Windows Recovery
}

entries = []
for drive in drives:
    try:
        # Use plain text output with explicit separator - more reliable than JSON
        out = subprocess.check_output(
            ['lsblk', '-ln', '-o', 'PATH,SIZE,FSTYPE,PARTTYPE', drive],
            stderr=subprocess.DEVNULL, text=True
        )
        log(f"lsblk output for {drive}:\n{out}")

        for line in out.strip().split('\n'):
            cols = line.split()
            if len(cols) < 2:
                continue

            path = cols[0]
            size = cols[1]

            # Remaining columns: FSTYPE might be empty, PARTTYPE might be empty
            # We need to figure out which columns are which
            # If there are 4 cols: PATH SIZE FSTYPE PARTTYPE
            # If there are 3 cols: PATH SIZE FSTYPE (no parttype) or PATH SIZE PARTTYPE (no fstype)
            # If there are 2 cols: PATH SIZE (no fstype, no parttype)
            fstype = ''
            partguid = ''
            if len(cols) == 4:
                fstype = cols[2]
                partguid = cols[3].lower()
            elif len(cols) == 3:
                # Could be fstype or parttype - GUIDs have dashes
                if '-' in cols[2] and len(cols[2]) > 30:
                    partguid = cols[2].lower()
                else:
                    fstype = cols[2]

            # Skip the drive itself
            if path == drive:
                continue

            # Skip /dev/mapper devices
            if '/mapper/' in path:
                log(f"Skip {path}: mapper device")
                continue

            # Skip EFI partition
            if path == efi_part:
                log(f"Skip {path}: EFI partition")
                continue

            # Skip protected GUIDs
            if partguid in protected_guids:
                log(f"Skip {path}: protected GUID {partguid}")
                continue

            # Skip NTFS, vfat
            if fstype.lower() in ('ntfs', 'vfat', 'fat32', 'fat16'):
                log(f"Skip {path}: protected fs {fstype}")
                continue

            # Skip tiny partitions (<1 GiB)
            try:
                s = size.upper()
                if 'T' in s:
                    gib = float(s.replace('T','')) * 1024
                elif 'G' in s:
                    gib = float(s.replace('G',''))
                elif 'M' in s:
                    gib = float(s.replace('M','')) / 1024
                else:
                    gib = 0
                if gib < 1:
                    log(f"Skip {path}: too small ({size})")
                    continue
            except Exception:
                log(f"Skip {path}: can't parse size '{size}'")
                continue

            label = fstype.lower() if fstype else 'unknown'
            entries.append(f"{path}|{size}|{label}|{drive}")
            log(f"ELIGIBLE: {path} {size} {label}")

    except Exception as e:
        log(f"ERROR processing {drive}: {e}")

for i, e in enumerate(entries):
    print(f"{i}:{e}")
PYEOF
)

    if [[ -z "$PART_LIST" ]]; then
        err "No deletable partitions found.\nShrink a Windows volume in Disk Management first, then re-run."
    fi

    echo -e "  ${WHITE}${BOLD}Deletable partitions:${NC}"
    echo
    while IFS= read -r line; do
        idx="${line%%:*}"
        rest="${line#*:}"
        IFS='|' read -r path size label drive <<< "$rest"
        printf "  ${CYAN}[%s]${NC}  %-16s  %8s  (%s)\n" \
            "$idx" "$path" "$size" "$label"
    done <<< "$PART_LIST"

    echo
    echo -e "  ${RED}${BOLD}WARNING: The selected partition will be PERMANENTLY DELETED.${NC}"
    ask "Which partition should be deleted for Arch? Enter the number:"
    read -rp "  > " DEL_CHOICE
    [[ "$DEL_CHOICE" =~ ^[0-9]+$ ]] || err "Invalid choice: $DEL_CHOICE"

    DEL_CHOSEN=$(echo "$PART_LIST" | grep "^${DEL_CHOICE}:")
    [[ -n "$DEL_CHOSEN" ]] || err "Invalid choice: $DEL_CHOICE"

    rest="${DEL_CHOSEN#*:}"
    IFS='|' read -r DEL_PART DEL_SIZE DEL_LABEL DEL_DRIVE <<< "$rest"

    echo
    echo -e "  ${RED}${BOLD}You are about to DELETE:  $DEL_PART  ($DEL_SIZE, $DEL_LABEL)${NC}"
    echo -e "  ${RED}${BOLD}This CANNOT be undone.${NC}"
    echo
    ask "Type  DELETE  (uppercase) to confirm:"
    read -rp "  > " DEL_CONFIRM
    [[ "$DEL_CONFIRM" == "DELETE" ]] || { echo "Aborted. Nothing was changed."; exit 0; }

    # Get partition number
    DEL_PART_NUM=$(lsblk -no PARTN "$DEL_PART" 2>/dev/null)
    if [[ -z "$DEL_PART_NUM" ]]; then
        DEL_PART_NUM=$(echo "$DEL_PART" | grep -o '[0-9]*$')
    fi

    [[ -n "$DEL_PART_NUM" ]] || err "Could not determine partition number for $DEL_PART"

    # Close any LUKS containers on this partition
    if blkid -o value -s TYPE "$DEL_PART" 2>/dev/null | grep -q "crypto_LUKS"; then
        # Find the mapper name if open
        MAPPER_NAME=$(lsblk -lno NAME,TYPE "$DEL_PART" 2>/dev/null \
            | awk '$2 == "crypt" {print $1}')
        if [[ -n "$MAPPER_NAME" ]]; then
            info "Closing LUKS container /dev/mapper/$MAPPER_NAME..."
            cryptsetup close "$MAPPER_NAME" 2>/dev/null || true
        fi
    fi

    # Unmount if mounted
    umount "$DEL_PART" 2>/dev/null || true

    info "Deleting partition $DEL_PART (partition $DEL_PART_NUM on $DEL_DRIVE)..."
    parted -s "$DEL_DRIVE" rm "$DEL_PART_NUM"
    partprobe "$DEL_DRIVE"
    sleep 2

    log "Partition deleted"

    # Re-scan the drive for free space and use the largest region
    info "Scanning $DEL_DRIVE for freed space..."
    FREE_REGION=$(parted -m "$DEL_DRIVE" unit MiB print free 2>/dev/null \
        | awk -F: '$NF ~ /free/ {
            start = $2; end = $3;
            gsub(/MiB/, "", start); gsub(/MiB/, "", end);
            size = end - start;
            if (size > max) { max = size; best_start = start; best_end = end }
        } END { if (max > 0) printf "%s|%s|%s", best_start, best_end, max/1024 }')

    [[ -n "$FREE_REGION" ]] \
        || err "Could not find free space on $DEL_DRIVE after deletion"

    IFS='|' read -r FREE_START FREE_END FREE_GiB <<< "$FREE_REGION"

    # Set variables for the rest of the script
    TARGET_DRIVE="$DEL_DRIVE"

    log "Using freed space: $TARGET_DRIVE  (~${FREE_GiB%.*} GiB)"
}

# -- Step 3: Gather user input --------------------------------
# Prints pre-formatted entries in columns, filled top-to-bottom so an
# alphabetical list reads naturally down each column.
_columns() {
    local width=$1; shift
    printf '%s\n' "$@" | awk -v W="$width" '
        { item[NR] = $0; if (length($0) > m) m = length($0) }
        END {
            if (NR == 0) exit
            cw = m + 3; cols = int((W - 2) / cw); if (cols < 1) cols = 1
            rows = int((NR + cols - 1) / cols)
            for (r = 1; r <= rows; r++) {
                line = "  "
                for (c = 0; c < cols; c++) {
                    i = r + c * rows
                    if (i <= NR) line = line sprintf("%-" cw "s", item[i])
                }
                sub(/ +$/, "", line); print line
            }
        }'
}

# _pick TITLE ENTER_LABEL ITEM...
# Numbered picker that always fits the screen: long lists are paged (n/p),
# and typing 2+ letters searches. Numbers never change while paging or
# searching, so what you type is what you saw.
# Result in PICK: 1..N = that item, 0 = Enter, -1 = typed text containing "/"
# (left in PICK_TEXT for callers that accept a full name).
_pick() {
    local title=$1 enter_label=$2; shift 2
    local -a items=("$@") view=()
    local n=$# width height d i maxlen cols rows per pages page=0 filter="" input
    width=$(tput cols 2>/dev/null) || width=0
    [[ "$width" =~ ^[0-9]+$ ]] && (( width >= 40 )) || width=80
    height=$(tput lines 2>/dev/null) || height=0
    [[ "$height" =~ ^[0-9]+$ ]] && (( height >= 12 )) || height=24
    d=${#n}
    PICK=0; PICK_TEXT=""
    while true; do
        view=(); maxlen=0
        for (( i = 1; i <= n; i++ )); do
            if [[ -z "$filter" || "${items[i-1],,}" == *"${filter,,}"* ]]; then
                view+=("$(printf "[%${d}d] %s" "$i" "${items[i-1]}")")
                (( ${#view[-1]} > maxlen )) && maxlen=${#view[-1]}
            fi
        done
        cols=$(( (width - 2) / (maxlen + 3) )); (( cols >= 1 )) || cols=1
        rows=$(( height - 8 )); (( rows >= 4 )) || rows=4
        per=$(( cols * rows ))
        pages=$(( (${#view[@]} + per - 1) / per ))
        (( page >= pages )) && page=$(( pages - 1 ))
        (( page < 0 )) && page=0

        echo
        echo -e "  ${WHITE}${BOLD}${title}${NC}${filter:+  (search: $filter)}$( (( pages > 1 )) && echo "  - page $(( page + 1 ))/$pages")"
        echo
        _columns "$width" "${view[@]:page*per:per}"
        echo
        local hint="number"
        (( pages > 1 )) && hint+=", n/p = next/previous page"
        hint+=", letters = search"
        [[ -n "$filter" ]] && hint+=", Enter = clear search" || hint+=", Enter = $enter_label"
        read -rp "  Choose ($hint): " input
        input=${input#"${input%%[![:space:]]*}"}; input=${input%"${input##*[![:space:]]}"}

        if [[ -z "$input" ]]; then
            if [[ -n "$filter" ]]; then filter=""; page=0; continue; fi
            PICK=0; return
        elif [[ "$input" =~ ^[0-9]+$ ]]; then
            if (( input >= 1 && input <= n )); then PICK=$input; return; fi
            warn "Please type a number from 1 to $n."
        elif [[ "$input" == n || "$input" == N ]]; then
            (( page + 1 < pages )) && page=$(( page + 1 ))
        elif [[ "$input" == p || "$input" == P ]]; then
            (( page > 0 )) && page=$(( page - 1 ))
        elif [[ "$input" == */* ]]; then
            PICK=-1; PICK_TEXT=$input; return
        elif (( ${#input} < 2 )); then
            warn "Type at least 2 letters to search."
        else
            local hit=0
            for (( i = 0; i < n; i++ )); do
                [[ "${items[i],,}" == *"${input,,}"* ]] && { hit=1; break; }
            done
            if (( hit )); then filter=$input; page=0; else warn "Nothing matches '$input'."; fi
        fi
    done
}

# Keyboard: console keymap (TTY + the disk-unlock prompt at boot) and desktop
# layout are chosen together, because the LUKS passphrase is typed on the
# console keymap both now and at every boot - they must never differ.
# Console names are Arch kbd names; several candidates are tried in order and
# checked against what this ISO really ships, with a safe US fallback.
choose_keyboard() {
    local -a KB_NAME=() KB_CONS=() KB_XKB=() KB_VAR=()
    local name cons xkb var def=0 choice idx km cand available
    while IFS='|' read -r name cons xkb var; do
        [[ -n "$name" ]] || continue
        KB_NAME+=("$name"); KB_CONS+=("$cons"); KB_XKB+=("$xkb"); KB_VAR+=("$var")
        [[ "$name" == "English (US)" ]] && def=${#KB_NAME[@]}
    done <<'KBEOF'
Belgian|be-latin1|be|
Brazilian (ABNT2)|br-abnt2|br|
Bulgarian (+ English)|us|us,bg|
Canadian French|cf|ca|
Canadian Multilingual|cf|ca|multix
Croatian|croat|hr|
Czech|cz-qwertz cz|cz|
Danish|dk-latin1|dk|
Dutch|nl|nl|
English (UK)|uk|gb|
English (US)|us|us|
English (US, Colemak)|colemak|us|colemak
English (US, Dvorak)|dvorak|us|dvorak
English (US, International)|us-acentos|us|intl
Estonian|et|ee|
Finnish|fi|fi|
French|fr-latin1|fr|
French (Bepo)|fr-bepo-latin9|fr|bepo
French (Swiss)|fr_CH-latin1|ch|fr
German|de-latin1|de|
German (Austria)|de-latin1|at|
German (Neo 2)|neo|de|neo
German (Swiss)|de_CH-latin1|ch|
Greek (+ English)|us|us,gr|
Hungarian|hu|hu|
Icelandic|is-latin1|is|
Irish|uk|ie|
Italian|it|it|
Japanese (106)|jp106|jp|
Latin American|la-latin1|latam|
Latvian|lv|lv|
Lithuanian|lt|lt|
Norwegian|no-latin1|no|
Polish|pl2|pl|
Portuguese|pt-latin1|pt|
Romanian|ro|ro|
Russian (+ English)|us|us,ru|
Serbian (Latin)|sr-latin|rs|latin
Slovak|sk-qwertz|sk|
Slovenian|slovene|si|
Spanish|es|es|
Swedish|sv-latin1|se|
Turkish (F)|trf|tr|f
Turkish (Q)|trq|tr|
Ukrainian (+ English)|us|us,ua|
KBEOF

    echo -e "  ${DIM}Layouts marked (+ English) keep US English for the console and the disk${NC}"
    echo -e "  ${DIM}unlock prompt; on the desktop switch between both with Super+Space.${NC}"
    while true; do
        _pick "Keyboard Layout" "English (US)" "${KB_NAME[@]}"
        (( PICK == 0 )) && choice=$def && break
        (( PICK > 0 )) && choice=$PICK && break
        warn "Please choose a number from the list."
    done
    idx=$(( choice - 1 ))

    available=$(localectl list-keymaps --no-pager 2>/dev/null)
    km=""
    for cand in ${KB_CONS[$idx]}; do
        if [[ -z "$available" ]] || grep -qxF "$cand" <<<"$available"; then
            km=$cand
            break
        fi
    done
    # loadkeys is the final word: it is exactly what the boot prompt will use.
    if [[ -z "$km" ]] || ! loadkeys "$km" >/dev/null 2>&1; then
        warn "The console keymap for '${KB_NAME[$idx]}' is not available on this ISO."
        warn "The console and disk-unlock prompt will use US English; the desktop still gets ${KB_NAME[$idx]}."
        km=us
        loadkeys us >/dev/null 2>&1 || true
    fi

    KEYBOARD_NAME=${KB_NAME[$idx]}
    KEYMAP=$km
    KEYMAP_X11=${KB_XKB[$idx]}
    KEYMAP_X11_VARIANT=${KB_VAR[$idx]}
    log "Keyboard: $KEYBOARD_NAME (console: $KEYMAP, desktop: $KEYMAP_X11${KEYMAP_X11_VARIANT:+ / $KEYMAP_X11_VARIANT})"
}

# Timezone: pick a region, then a city - both numbered and alphabetical. A
# full name like Europe/Paris can be typed at either prompt. The list comes
# from the ISO itself, so it is always complete and valid.
choose_timezone() {
    local -a all=() regions=() zones=() labels=()
    local default="Europe/Zurich" region z
    mapfile -t all < <(timedatectl list-timezones --no-pager 2>/dev/null)
    if (( ${#all[@]} == 0 )) && [[ -r /usr/share/zoneinfo/tzdata.zi ]]; then
        mapfile -t all < <(awk '$1 == "Z" || $1 == "L" { print ($1 == "Z" ? $2 : $3) }' \
            /usr/share/zoneinfo/tzdata.zi | sort -u)
    fi
    if (( ${#all[@]} == 0 )); then
        # Last resort: typed entry, validated against the zoneinfo files.
        while true; do
            ask "Timezone (press Enter for $default):"
            read -rp "  > " TIMEZONE
            TIMEZONE=${TIMEZONE:-$default}
            [[ "$TIMEZONE" != *..* && -f "/usr/share/zoneinfo/$TIMEZONE" ]] && break
            warn "Unknown timezone '$TIMEZONE' - try again (e.g. Europe/Zurich)."
        done
        log "Timezone: $TIMEZONE"
        return
    fi

    # Only the ten real regions; legacy alias folders (US/, Canada/, Brazil/ ...)
    # just duplicate America/*, and can still be typed as a full name.
    mapfile -t regions < <(printf '%s\n' "${all[@]}" | awk -F/ '
        NF > 1 && $1 ~ /^(Africa|America|Antarctica|Arctic|Asia|Atlantic|Australia|Europe|Indian|Pacific)$/ { print $1 }' | sort -u)
    regions+=("UTC")

    while true; do
        TIMEZONE=""
        _pick "Timezone - region" "$default" "${regions[@]}"
        if (( PICK == 0 )); then
            TIMEZONE=$default
        elif (( PICK == -1 )); then
            if printf '%s\n' "${all[@]}" | grep -qxF -- "$PICK_TEXT"; then
                TIMEZONE=$PICK_TEXT
            else
                warn "Unknown timezone '$PICK_TEXT'."; continue
            fi
        else
            region=${regions[PICK-1]}
            if [[ "$region" == "UTC" ]]; then
                TIMEZONE=UTC
            else
                mapfile -t zones < <(printf '%s\n' "${all[@]}" | grep "^${region}/" | sort)
                labels=()
                for z in "${zones[@]}"; do
                    z=${z#"$region"/}
                    labels+=("${z//_/ }")
                done
                _pick "Timezone - $region" "back to regions" "${labels[@]}"
                (( PICK > 0 )) || continue
                TIMEZONE=${zones[PICK-1]}
            fi
        fi
        # It must exist as a zone file: /etc/localtime is symlinked to it.
        [[ -f "/usr/share/zoneinfo/$TIMEZONE" ]] && break
        warn "'$TIMEZONE' has no zone file on this ISO - please pick another."
    done
    log "Timezone: $TIMEZONE"
}

gather_input() {
    hr "Installation Config"
    echo -e "  ${WHITE}${BOLD}Configure your NiiX Arch install:${NC}"
    echo

    # -- Keyboard layout --------------------------------------
    # Chosen first and applied to the live ISO immediately, so the passwords
    # below are typed on the same layout the boot-time unlock prompt uses.
    choose_keyboard

    while true; do
        ask "Hostname (e.g. archbox, press Enter for 'niixarch'):"
        read -rp "  > " HOSTNAME
        HOSTNAME=${HOSTNAME:-niixarch}
        if [[ "$HOSTNAME" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]]; then
            break
        fi
        warn "Invalid hostname: '$HOSTNAME' - use only letters, digits, and hyphens (not at the start or end), max 63 characters. Try again."
    done

    while true; do
        ask "Username:"
        read -rp "  > " USERNAME
        if [[ -z "$USERNAME" ]]; then
            warn "Username cannot be empty. Try again."
            continue
        fi
        if [[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
            # Names taken by the base system or created later by packages
            # (gdm, polkitd, ...). Caught here, before the disk is touched,
            # instead of failing at useradd after partitioning.
            case "$USERNAME" in
                root|bin|daemon|mail|ftp|http|nobody|dbus|polkitd|rtkit|gdm|colord|\
                avahi|geoclue|usbmux|flatpak|git|dnsmasq|saned|tss|uuidd|alpm|ntp|\
                cups|lp|games|kvm|render|video|audio|input|wheel|users|storage|\
                optical|adm|log|utmp|tty|disk|floppy|scanner|rfkill|sgx|\
                systemd-*|nm-*)
                    warn "'$USERNAME' is reserved by the system - please choose another."
                    continue ;;
            esac
            if getent passwd "$USERNAME" >/dev/null 2>&1 || getent group "$USERNAME" >/dev/null 2>&1; then
                warn "'$USERNAME' is already a system account - please choose another."
                continue
            fi
            break
        fi
        warn "Invalid username: '$USERNAME' - must start with a lowercase letter or underscore, and contain only lowercase letters, digits, hyphens, or underscores. Try again."
    done

    echo
    while true; do
        ask "User & root password:"
        read -rsp "  > " USER_PASS; echo
        if [[ -z "$USER_PASS" ]]; then
            warn "Password cannot be empty - please try again."
            continue
        fi
        ask "Confirm password:"
        read -rsp "  > " USER_PASS2; echo
        if [[ "$USER_PASS" != "$USER_PASS2" ]]; then
            warn "Passwords do not match - please try again."
        else
            break
        fi
    done

    echo
    warn "LUKS passphrase - typed every time you boot into Arch:"
    while true; do
        ask "LUKS passphrase:"
        read -rsp "  > " LUKS_PASS; echo
        if [[ ${#LUKS_PASS} -lt 8 ]]; then
            warn "LUKS passphrase must be at least 8 characters - it is the only thing protecting the disk."
            continue
        fi
        ask "Confirm LUKS passphrase:"
        read -rsp "  > " LUKS_PASS2; echo
        if [[ "$LUKS_PASS" != "$LUKS_PASS2" ]]; then
            warn "LUKS passphrases do not match - please try again."
        else
            break
        fi
    done

    choose_timezone

    echo
    echo -e "  ${WHITE}${BOLD}CPU Vulnerability Mitigations${NC}"
    echo -e "  ${DIM}Disabling gives ~5-10% more FPS but reduces side-channel protection.${NC}"
    echo -e "  ${GREEN}[1]${NC}  ${WHITE}OFF${NC}  - Max performance  (mitigations=off)"
    echo -e "  ${GREEN}[2]${NC}  ${WHITE}ON${NC}   - Keep protections  (safer for banking/crypto)"
    while true; do
        read -rp "  Choose [1/2]: " MIT_CHOICE
        case "$MIT_CHOICE" in
            1) USE_MITIGATIONS=false; log "Mitigations: OFF"; break ;;
            2) USE_MITIGATIONS=true;  log "Mitigations: ON";  break ;;
            *) warn "Please type 1 or 2 - there is no silent default for a security setting." ;;
        esac
    done
}

# -- Step 4: Confirm ------------------------------------------
confirm() {
    hr "Summary & Confirmation"
    echo -e "  ${WHITE}${BOLD}Review carefully before continuing:${NC}"
    echo
    echo -e "  ${PINK}-- Hardware --------------------------------------${NC}"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "CPU:"  "$CPU_MODEL ($CPU_VENDOR)"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "GPU:"  "$GPU_MODEL ($GPU_VENDOR)"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "RAM:"  "~${MEM_TOTAL_GB}GB"
    echo
    echo -e "  ${PINK}-- Install mode ----------------------------------${NC}"
    if [[ "$INSTALL_MODE" == "dualboot" ]]; then
        printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Mode:"            "Dual-boot  (Windows preserved)"
        printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "EFI (/boot):"     "$EFI_PART  (reused, NOT reformatted)"
        printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "New partition:"   "$TARGET_DRIVE  (free space)"
    else
        printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Mode:"            "Single-boot  (standalone Arch)"
        printf "  ${RED}x${NC}  %-22s ${RED}%s${NC}\n"   "WIPE target:"     "$SINGLE_DRIVE  - ENTIRE DRIVE WIPED"
        printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "EFI partition:"   "512 MiB  (new, created on $SINGLE_DRIVE)"
        printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Root partition:"  "Remaining space on $SINGLE_DRIVE"
    fi
    echo
    echo -e "  ${PINK}-- Configuration ---------------------------------${NC}"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Bootloader:"    "Limine (UEFI)"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Keyboard:"      "$KEYBOARD_NAME  (console: $KEYMAP)"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Kernel:"        "linux-cachyos (BORE - installed first-boot)"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Encryption:"    "LUKS2"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Filesystem:"    "Btrfs  -  @  @home  @snapshots  @var_log"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Swap:"          "ZRAM (zstd, auto-sized)"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Hostname:"      "$HOSTNAME"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Username:"      "$USERNAME"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Desktop:"       "GNOME"
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Mitigations:"   "$([ "$USE_MITIGATIONS" = true ] && echo ON || echo OFF)"
    echo
    echo -e "  ${PINK}-- Security trade-offs you are accepting -------${NC}"
    printf "  ${YELLOW}!${NC}  %-22s ${WHITE}%s${NC}\n" "Auto-login:" "ON - after the LUKS passphrase, the desktop opens as"
    printf "  ${YELLOW} ${NC}  %-22s ${WHITE}%s${NC}\n" "" "'$USERNAME' (sudo-capable) with no second password"
    if [[ "$USE_MITIGATIONS" == false ]]; then
        printf "  ${YELLOW}!${NC}  %-22s ${WHITE}%s${NC}\n" "CPU mitigations:" "OFF - side-channel protections disabled for FPS"
    fi
    printf "  ${CYAN}-${NC}  %-22s ${WHITE}%s${NC}\n" "Hotspot routing:" "only while the hotspot runs (NetworkManager-managed)"
    echo
    if [[ "$INSTALL_MODE" == "dualboot" ]]; then
        warn "Only the selected free space will be touched - Windows is safe."
    else
        warn "ALL data on $SINGLE_DRIVE will be permanently destroyed."
        warn "This includes any OS, files, or partitions on that drive."
    fi
    echo
    echo -e "  ${RED}${BOLD}Type  YES  (uppercase) to begin - this cannot be undone:${NC}"
    read -rp "  > " CONFIRM_INPUT
    [[ "$CONFIRM_INPUT" == "YES" ]] || { echo "  Aborted. Nothing was changed."; exit 0; }
}

# -- Step 5: Create partition in selected free space ----------
create_partition() {
    hr "Partition Creation"
    info "Creating partition on $TARGET_DRIVE..."

    PARTS_BEFORE=$(lsblk -lno NAME "$TARGET_DRIVE" 2>/dev/null)

    PART_END=$(( ${FREE_END%.*} - 1 ))
    parted -s "$TARGET_DRIVE" mkpart primary "${FREE_START}MiB" "${PART_END}MiB" \
        || err "Failed to create partition on $TARGET_DRIVE"

    partprobe "$TARGET_DRIVE" 2>/dev/null || true

    # Wait for the kernel AND udev to publish the new node (up to ~10s)
    # instead of a fixed sleep that is too short on some controllers.
    NEW_PART_NAME=""
    local _try
    for _try in $(seq 1 20); do
        udevadm settle --timeout=5 2>/dev/null || true
        PARTS_AFTER=$(lsblk -lno NAME "$TARGET_DRIVE" 2>/dev/null)
        NEW_PART_NAME=$(diff <(echo "$PARTS_BEFORE") <(echo "$PARTS_AFTER") \
            | grep '^>' | awk '{print $2}' | head -1)
        [[ -n "$NEW_PART_NAME" && -b "/dev/$NEW_PART_NAME" ]] && break
        sleep 0.5
    done

    [[ -n "$NEW_PART_NAME" ]] \
        || err "Could not identify new partition. Run: lsblk $TARGET_DRIVE"

    LUKS_PART="/dev/$NEW_PART_NAME"
    [[ -b "$LUKS_PART" ]] || err "New partition $LUKS_PART is not a block device"

    # Set Linux filesystem type GUID on GPT
    NEW_PART_NUM=$(lsblk -no PARTN "$LUKS_PART" 2>/dev/null \
        || echo "$LUKS_PART" | grep -o '[0-9]*$')
    parted -s "$TARGET_DRIVE" type "$NEW_PART_NUM" \
        "0FC63DAF-8483-4772-8E79-3D69D8477DE4" 2>/dev/null \
        || true   # older parted may not support 'type'; harmless

    log "New partition: $LUKS_PART"
}

# -- Step 6: LUKS2 encryption ---------------------------------
setup_luks() {
    hr "LUKS2 Encryption Setup"
    log "Formatting $LUKS_PART with LUKS2..."

    printf '%s' "$LUKS_PASS" | cryptsetup luksFormat \
        --batch-mode \
        --type luks2 \
        "$LUKS_PART" \
        --key-file=- \
        || err "cryptsetup luksFormat failed on $LUKS_PART"

    # Back up the header immediately - a corrupted LUKS header on an
    # otherwise-healthy disk is unrecoverable without one, and right after
    # formatting (before there's any real data at risk) is exactly when to
    # take it. Saved alongside the install log so it rides along on the same
    # USB copy offered at the end of the install (or on failure via err()).
    LUKS_HEADER_BACKUP="/root/niixarch-luks-header-backup.img"
    if cryptsetup luksHeaderBackup "$LUKS_PART" --header-backup-file "$LUKS_HEADER_BACKUP" 2>/dev/null; then
        chmod 600 "$LUKS_HEADER_BACKUP"
        log "LUKS header backed up to $LUKS_HEADER_BACKUP (copied to USB alongside the install log)"
        info "Keep that backup private: it opens the disk with THIS passphrase even after you"
        info "change it later. If the passphrase is ever exposed, change it AND delete the backup."
    else
        warn "Could not back up the LUKS header - you can run 'cryptsetup luksHeaderBackup' manually later"
    fi

    LUKS_UUID=$(blkid -s UUID -o value "$LUKS_PART")
    [[ -n "$LUKS_UUID" ]] || err "Could not read UUID from $LUKS_PART"
    log "LUKS2 UUID: $LUKS_UUID"

    log "Opening container as /dev/mapper/$MAPPER..."
    printf '%s' "$LUKS_PASS" | cryptsetup open \
        "$LUKS_PART" "$MAPPER" \
        --key-file=- \
        || err "cryptsetup open failed on $LUKS_PART"

    [[ -b "/dev/mapper/$MAPPER" ]] || err "Failed to open LUKS container"
    log "Container open at /dev/mapper/$MAPPER"
}

# -- Step 7: Btrfs + subvolumes -------------------------------
setup_btrfs() {
    hr "Btrfs Filesystem"
    log "Formatting /dev/mapper/$MAPPER as Btrfs..."
    mkfs.btrfs -f /dev/mapper/$MAPPER || err "mkfs.btrfs failed on /dev/mapper/$MAPPER"

    log "Creating subvolumes..."
    mount /dev/mapper/$MAPPER /mnt || err "Failed to mount /dev/mapper/$MAPPER"
    btrfs subvolume create /mnt/@          || err "Failed to create subvolume @"
    btrfs subvolume create /mnt/@home      || err "Failed to create subvolume @home"
    btrfs subvolume create /mnt/@snapshots || err "Failed to create subvolume @snapshots"
    btrfs subvolume create /mnt/@var_log   || err "Failed to create subvolume @var_log"
    umount /mnt || err "Failed to unmount /mnt after subvolume creation"

    log "Mounting subvolumes..."
    mount -o "${BTRFS_OPTS},subvol=@"          /dev/mapper/$MAPPER /mnt || err "Failed to mount @"
    mkdir -p /mnt/{boot,home,.snapshots,var/log}
    mount "$EFI_PART" /mnt/boot || err "Failed to mount EFI partition $EFI_PART"
    mount -o "${BTRFS_OPTS},subvol=@home"      /dev/mapper/$MAPPER /mnt/home       || err "Failed to mount @home"
    mount -o "${BTRFS_OPTS},subvol=@snapshots" /dev/mapper/$MAPPER /mnt/.snapshots || err "Failed to mount @snapshots"
    mount -o "${BTRFS_OPTS},subvol=@var_log"   /dev/mapper/$MAPPER /mnt/var/log    || err "Failed to mount @var_log"

    log "Btrfs mounted"
}

# -- Step 7b: Remove ALL traces of previous Arch/Limine ------
clean_efi() {
    hr "EFI Partition Cleanup"
    info "Removing all traces of previous Arch/Limine installations..."
    info "(Windows and EFI/Microsoft files will NOT be touched)"

    # -- 1. Clean files from EFI partition --------------------
    # Kernels and initramfs (stock + cachyos) at the ESP root. A previous NiiX
    # install is recognised by its Limine branding and cleaned silently. Any
    # other Arch-family install that keeps its kernels at the ESP root (e.g.
    # another Limine-based distro in a triple-boot) would lose them - and this
    # install writes the same filenames anyway - so that case needs consent.
    local stale_kernels=() f
    for f in /mnt/boot/vmlinuz-linux* /mnt/boot/initramfs-linux*.img; do
        [ -e "$f" ] && stale_kernels+=("$f")
    done
    if [ "${#stale_kernels[@]}" -gt 0 ]; then
        if grep -qs 'NiiX Arch' /mnt/boot/limine.conf /mnt/boot/limine.cfg \
                /mnt/boot/limine/limine.conf /mnt/boot/limine/limine.cfg \
                /mnt/boot/EFI/limine/limine.conf /mnt/boot/EFI/limine/limine.cfg \
                /mnt/boot/EFI/BOOT/limine.conf /mnt/boot/EFI/BOOT/limine.cfg; then
            info "Removing kernels left by a previous NiiX install..."
        else
            warn "Found Linux kernel files on this EFI partition that do NOT belong to a previous NiiX install:"
            for f in "${stale_kernels[@]}"; do echo "    $f"; done
            warn "If another Linux install boots from these, it will stop booting (NiiX uses the same filenames)."
            ask "Delete them and continue? [y/N]:"
            read -rp "  > " DELETE_FOREIGN_KERNELS
            [[ "$DELETE_FOREIGN_KERNELS" =~ ^[Yy]$ ]] \
                || err "Aborted at your request - the other install's kernel files were left untouched."
        fi
        rm -f "${stale_kernels[@]}"
    fi

    # Limine configs + EFI binary - also unambiguously ours, only Limine uses
    # these exact paths.
    rm -rf /mnt/boot/limine
    rm -f  /mnt/boot/limine.cfg
    rm -f  /mnt/boot/limine.conf
    rm -rf /mnt/boot/EFI/limine

    # GRUB, systemd-boot, and generic UKIs are NOT unambiguously ours - on a
    # shared ESP (triple-boot, another distro previously installed here)
    # these could belong to someone else's working bootloader. Warn and
    # require explicit confirmation before touching them instead of silently
    # deleting - that's data loss nobody consented to.
    FOREIGN_BOOT_PATHS=()
    for p in /mnt/boot/EFI/GRUB /mnt/boot/grub /mnt/boot/EFI/systemd /mnt/boot/loader /mnt/boot/EFI/Linux; do
        [ -e "$p" ] && FOREIGN_BOOT_PATHS+=("$p")
    done
    if [ "${#FOREIGN_BOOT_PATHS[@]}" -gt 0 ]; then
        warn "Found other bootloader files on this EFI partition (could be another Linux install sharing this drive):"
        for p in "${FOREIGN_BOOT_PATHS[@]}"; do echo "    $p"; done
        ask "Delete these too? Only say yes if you're sure they're stale NiiX/Arch leftovers, not another OS. [y/N]:"
        read -rp "  > " DELETE_FOREIGN_BOOT
        if [[ "$DELETE_FOREIGN_BOOT" =~ ^[Yy]$ ]]; then
            for p in "${FOREIGN_BOOT_PATHS[@]}"; do rm -rf "$p"; done
            log "Removed other bootloader files"
        else
            log "Left other bootloader files untouched"
        fi
    fi

    log "EFI partition cleaned"

    # -- 2. Remove old Limine/Arch UEFI boot entries ---------
    info "Cleaning old UEFI NVRAM boot entries..."
    while IFS= read -r bootnum; do
        efibootmgr -b "$bootnum" -B 2>/dev/null \
            && log "Removed UEFI entry Boot${bootnum}" \
            || true
    done < <(efibootmgr 2>/dev/null \
        | grep -iE "limine|arch" \
        | grep -oP 'Boot\K[0-9A-Fa-f]{4}')

    log "UEFI NVRAM cleaned"
}

# -- Step 8: Swiss mirrors & base install ---------------------
install_base() {
    hr "Base System Install"
    info "Fetching fastest $MIRROR_COUNTRY mirrors..."
    pacman -Sy --noconfirm reflector 2>/dev/null \
        && reflector \
            --country "$MIRROR_COUNTRY" \
            --latest 10 \
            --protocol https \
            --sort rate \
            --save /etc/pacman.d/mirrorlist \
        && log "Mirrors updated" \
        || warn "reflector failed - using default mirrors"

    # Speed: pacstrap downloads through the ISO's pacman.conf, which ships with
    # ParallelDownloads commented out (i.e. one file at a time). Raising it here
    # is the single biggest win on the 10-20 minute base install, and
    # DisableDownloadTimeout stops a slow-but-alive mirror from aborting.
    if grep -q '^#*ParallelDownloads' /etc/pacman.conf; then
        sed -i 's/^#*ParallelDownloads.*/ParallelDownloads = 15/' /etc/pacman.conf
    else
        sed -i '/^\[options\]/a ParallelDownloads = 15' /etc/pacman.conf
    fi
    grep -q '^DisableDownloadTimeout' /etc/pacman.conf \
        || sed -i '/^\[options\]/a DisableDownloadTimeout' /etc/pacman.conf
    log "ISO pacman tuned: 15 parallel downloads, no download timeout"

    # Write vconsole.conf BEFORE pacstrap so mkinitcpio's keymap hook doesn't error
    mkdir -p /mnt/etc
    echo "KEYMAP=${KEYMAP}" > /mnt/etc/vconsole.conf

    log "Installing base system (this takes 10-20 minutes)..."
    local n=1
    until pacstrap /mnt \
        base base-devel linux linux-firmware \
        networkmanager wpa_supplicant iw efibootmgr \
        sudo nano git wget curl python \
        ntfs-3g dosfstools \
        btrfs-progs cryptsetup \
        limine \
        pipewire pipewire-alsa pipewire-pulse wireplumber \
        bluez bluez-utils \
        iio-sensor-proxy \
        dconf \
        unzip
    do
        if [ "$n" -ge 3 ]; then
            err "pacstrap failed after $n attempts - base system install could not complete"
        fi
        warn "pacstrap failed (mirror/DNS blip?) - refreshing databases and retrying ($n/3)..."
        pacman -Syy --noconfirm 2>/dev/null || true
        sleep 3
        n=$((n + 1))
    done

    log "Base system installed"
}

# -- CachyOS repo + kernel ------------------------------------
# (CachyOS kernel installed during first-boot - needs live system for PGP keys)

# -- Enable multilib + parallel downloads (must run before any package install) --
enable_multilib() {
    hr "Enabling multilib"
    info "Enabling multilib repository and parallel downloads..."

    if ! grep -q "^\[multilib\]" /mnt/etc/pacman.conf; then
        sed -i '/^#\[multilib\]/,/^#Include/ s/^#//' /mnt/etc/pacman.conf
        log "multilib enabled"
    else
        log "multilib already enabled"
    fi

    if grep -q '^#*ParallelDownloads' /mnt/etc/pacman.conf; then
        sed -i 's/^#*ParallelDownloads.*/ParallelDownloads = 15/' /mnt/etc/pacman.conf
    else
        sed -i '/^\[options\]/a ParallelDownloads = 15' /mnt/etc/pacman.conf
    fi
    grep -q '^DisableDownloadTimeout' /mnt/etc/pacman.conf \
        || sed -i '/^\[options\]/a DisableDownloadTimeout' /mnt/etc/pacman.conf
    log "Parallel downloads set to 15 (no download timeout)"

    # Speed: makepkg defaults to ONE compile job and then re-compresses every
    # built package with single-threaded zstd. The AUR builds at first boot are
    # the slowest part of the whole install, and both of those are pure waste on
    # a multi-core gaming machine.
    #   MAKEFLAGS  - compile with every core
    #   PKGEXT     - do not compress packages that are installed immediately
    #   COMPRESSZST- multi-threaded, for anything that still is compressed
    if [[ -f /mnt/etc/makepkg.conf ]]; then
        sed -i -e 's/^#\?MAKEFLAGS=.*/MAKEFLAGS="-j\$(nproc)"/' \
               -e "s/^#\?PKGEXT=.*/PKGEXT='.pkg.tar'/" \
               -e 's/^#\?COMPRESSZST=.*/COMPRESSZST=(zstd -c -T0 --fast -)/' \
               /mnt/etc/makepkg.conf
        grep -q '^MAKEFLAGS=' /mnt/etc/makepkg.conf \
            || echo 'MAKEFLAGS="-j$(nproc)"' >> /mnt/etc/makepkg.conf
        grep -q '^PKGEXT=' /mnt/etc/makepkg.conf \
            || echo "PKGEXT='.pkg.tar'" >> /mnt/etc/makepkg.conf
        log "makepkg tuned: all cores, no package re-compression (faster AUR builds)"
    fi

    # Force a real (dereferenced) resolv.conf into the chroot AND always append
    # public fallback resolvers (Cloudflare + Quad9). arch-chroot's bind-mount
    # silently skips if the target is a symlink, and copying only the ISO's
    # resolver leaves DNS entirely dependent on the ISO's DHCP/stub resolver -
    # if that dies mid-install (minutes later) every mirror fails with "Could
    # not resolve host", which looks like a mirror outage but isn't. Appending
    # fallbacks lets glibc fall through to a reachable resolver on timeout.
    harden_dns
    if ! arch-chroot /mnt getent hosts archlinux.org &>/dev/null; then
        warn "DNS not resolving in chroot yet - waiting for it to recover..."
        wait_for_dns || warn "DNS still flaky - continuing on public fallback resolvers"
    fi

    # Full sync+upgrade (never a bare -Sy: a partial-upgrade DB refresh without an
    # upgrade is the classic Arch breakage where new libs mismatch old packages).
    # Retry on mirror blips instead of hard-failing on the first transient error -
    # a single flaky mirror shouldn't tear down a 20-minute install.
    local n=1
    until arch-chroot /mnt pacman -Syu --noconfirm; do
        if [ "$n" -ge 3 ]; then
            err "pacman -Syu failed after $n attempts while enabling multilib"
        fi
        warn "Mirror/DNS error - re-checking DNS and refreshing databases, retry ($n/3)..."
        wait_for_dns || true
        arch-chroot /mnt pacman -Syyu --noconfirm 2>/dev/null || true
        n=$((n + 1))
    done
    log "Package databases synced and system upgraded"
}

# -- GPU drivers (auto-detected) ------------------------------
install_gpu_drivers() {
    hr "GPU Base Userspace"

    # DB was already synced + upgraded by enable_multilib(); no extra -Sy here (a bare
    # -Sy before installing would risk a partial upgrade).

    # Minimal Mesa/Vulkan so the FIRST boot reaches the desktop on the iGPU and has
    # 32-bit GL for Steam. The actual vendor drivers and the full Optimus/PRIME setup
    # (NVIDIA legacy 580xx/470xx, nvidia-prime, switcheroo-control, RTD3 workaround,
    # initramfs) are installed at first boot by CachyOS hardware detection (chwd),
    # which is the tested path - we no longer hand-roll driver logic.
    local base_pkgs=(mesa lib32-mesa vulkan-icd-loader lib32-vulkan-icd-loader \
                     vulkan-mesa-layers lib32-vulkan-mesa-layers)
    if [[ "$HAS_INTEL" -gt 0 ]]; then
        base_pkgs+=(vulkan-intel lib32-vulkan-intel intel-media-driver)
        info "Intel graphics detected -> mesa + vulkan-intel"
    fi
    if [[ "$HAS_AMD" -gt 0 ]]; then
        base_pkgs+=(vulkan-radeon lib32-vulkan-radeon libva-mesa-driver lib32-libva-mesa-driver)
        info "AMD graphics detected -> mesa + vulkan-radeon"
    fi
    pac_install_retry "${base_pkgs[@]}" \
        || warn "Some Mesa/Vulkan packages failed to install even after retries."

    # Shader cache - harmless, vendor-agnostic. (No MOZ_DISABLE_RDD_SANDBOX:
    # current Firefox does VAAPI inside the sandboxed RDD process, so disabling
    # that sandbox system-wide only weakens security.)
    cat >> /mnt/etc/environment <<'COMMONENV'
__GL_SHADER_DISK_CACHE=1
__GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1
COMMONENV

    # Force EVERYTHING onto the discrete GPU globally, instead of the usual
    # per-game prime-run/DRI_PRIME launch options. This is a gaming distro and
    # is assumed to stay on AC power, so we skip hybrid-graphics power saving
    # entirely rather than requiring per-game launch-option edits. Only write
    # the vars for vendors actually present - __GLX_VENDOR_LIBRARY_NAME=nvidia
    # on a system with no NVIDIA GLX vendor breaks GLX apps outright, it's not
    # a harmless no-op like the other vars.
    if [[ "$HAS_NVIDIA" -gt 0 ]]; then
        cat >> /mnt/etc/environment <<'NVOFFLOAD'
__NV_PRIME_RENDER_OFFLOAD=1
__NV_PRIME_RENDER_OFFLOAD_PROVIDER=NVIDIA-G0
__GLX_VENDOR_LIBRARY_NAME=nvidia
NVOFFLOAD
        info "NVIDIA detected -> forcing discrete GPU render offload globally"
    fi
    if [[ "$HAS_AMD" -gt 0 ]]; then
        cat >> /mnt/etc/environment <<'AMDOFFLOAD'
DRI_PRIME=1
AMDOFFLOAD
        info "AMD detected -> forcing DRI_PRIME=1 globally"
    fi

    log "GPU base userspace installed (chwd configures the real drivers at first boot)"
}

# -- DNS resilience -------------------------------------------
# Copy the live resolver into the chroot, then ALWAYS append public fallbacks so
# a mid-install death of the ISO's DHCP/stub resolver can't take DNS down (glibc
# falls through to the next nameserver on timeout). Idempotent - safe to re-run.
harden_dns() {
    local rc=/mnt/etc/resolv.conf
    # /mnt/etc/resolv.conf can be an arch-chroot bind mount (EBUSY on rm, and
    # writing through it would truncate the LIVE ISO's own resolver). Drop the
    # mount first, then recreate the file.
    umount "$rc" 2>/dev/null || true
    rm -f "$rc" 2>/dev/null || true
    cat /etc/resolv.conf > "$rc" 2>/dev/null || true
    grep -q '^nameserver 1\.1\.1\.1' "$rc" 2>/dev/null || echo 'nameserver 1.1.1.1' >> "$rc"
    grep -q '^nameserver 9\.9\.9\.9' "$rc" 2>/dev/null || echo 'nameserver 9.9.9.9' >> "$rc"
    grep -q '^options '           "$rc" 2>/dev/null || echo 'options timeout:2 attempts:3 rotate' >> "$rc"
}

# Block until the chroot resolves a hostname again (~60s max), re-hardening DNS
# on each attempt so a transient resolver outage self-heals instead of aborting
# the install. Returns 0 as soon as resolution works.
wait_for_dns() {
    local i
    for i in $(seq 1 12); do
        arch-chroot /mnt getent hosts archlinux.org &>/dev/null && return 0
        harden_dns
        sleep 5
    done
    arch-chroot /mnt getent hosts archlinux.org &>/dev/null
}

# Record an optional package that could not be installed now, so first-boot can
# retry it (with a Flatpak fallback where one exists) instead of the whole
# install aborting over one transient blip on a non-essential app.
defer_pkg() {
    mkdir -p /mnt/var/lib/niixarch
    grep -qxF "$1" /mnt/var/lib/niixarch/deferred 2>/dev/null \
        || echo "$1" >> /mnt/var/lib/niixarch/deferred
}

# -- All pacman packages (gaming, security, tools) ------------
# Retry through mirror/DNS blips (waiting for DNS + refreshing databases between
# attempts) instead of failing on the first transient error - this is the exact
# failure class that has taken down this install before (a resolver hiccup looks
# identical to "package unavailable" in pacman's output, but waiting for DNS and
# retrying usually clears it). Returns 0 only if every package in $@ installs.
pac_install_retry() {
    local n=1
    until arch-chroot /mnt pacman -S --noconfirm --needed "$@"; do
        if [ "$n" -ge 3 ]; then
            return 1
        fi
        warn "Install error - re-checking DNS + refreshing databases, retry ($n/3)..."
        wait_for_dns || true
        arch-chroot /mnt pacman -Syyu --noconfirm 2>/dev/null || true
        n=$((n + 1))
    done
    return 0
}

# Install a batch into the target. If the atomic transaction fails for ANY reason
# (a mirror blip, a single unavailable package, a provider prompt), retry each
# package individually so one failure can't silently wipe out the whole group.
chroot_install() {
    if pac_install_retry "$@"; then return 0; fi
    warn "Batch install failed after retries - retrying each package individually..."
    local p okc=0 badc=0
    for p in "$@"; do
        if pac_install_retry "$p"; then okc=$((okc+1))
        else warn "  could not install: $p"; badc=$((badc+1)); fi
    done
    log "Per-package retry: ${okc} installed, ${badc} failed"
    return 0
}

# Best-effort extras that are subject to multilib churn (Arch has been dropping
# and re-adding lib32 packages; some now live only in the AUR). Try each on its
# own so a name that isn't currently in the repos is quietly skipped instead of
# collapsing the whole main transaction into the slow per-package fallback.
# These are nice-to-have 32-bit codecs, never required for a working system.
install_optional() {
    local p
    for p in "$@"; do
        if arch-chroot /mnt pacman -S --noconfirm --needed "$p" &>/dev/null; then
            info "optional 32-bit codec installed: $p"
        else
            info "optional 32-bit codec not in repos right now - skipped: $p"
        fi
    done
}

install_packages() {
    hr "Package Install"
    info "Installing packages (gaming, security, tools)..."

    chroot_install \
        linux-headers \
        gamemode lib32-gamemode mangohud lib32-mangohud \
        gamescope \
        wine winetricks \
        vkd3d lib32-vkd3d \
        ananicy-cpp \
        lib32-alsa-plugins lib32-libpulse \
        ufw \
        zram-generator irqbalance \
        power-profiles-daemon \
        flatpak \
        dnsmasq \
        snapper snap-pac \
        vlc \
        filezilla libreoffice-fresh signal-desktop \
        xorg-server \
        xorg-xwayland \
        libva-utils dmidecode \
        gnome-shell-extension-appindicator \
        reflector

    # Optional 32-bit codecs, best-effort (see install_optional). Kept out of the
    # batch above so their availability can't affect the core install.
    install_optional lib32-openal lib32-gst-plugins-base lib32-gst-plugins-good

    # Steam - requires multilib. Non-fatal: a transient mirror/DNS blip on one
    # app must not abort a whole install. If it fails now, first-boot retries it.
    info "Installing Steam..."
    if pac_install_retry steam; then
        log "Steam installed"
    else
        warn "Steam not installed now (transient?) - deferred to first boot"
        defer_pkg steam
    fi

    # Lutris - non-fatal; first-boot retries from the repo, then Flatpak.
    info "Installing Lutris..."
    if pac_install_retry lutris; then
        log "Lutris installed"
    else
        warn "Lutris not installed now (transient?) - deferred to first boot"
        defer_pkg lutris
    fi

    # fastfetch - cosmetic; never worth aborting the install for.
    info "Installing fastfetch..."
    if pac_install_retry fastfetch; then
        log "fastfetch installed"
    else
        warn "fastfetch not installed now (transient?) - deferred to first boot"
        defer_pkg fastfetch
    fi

    # CPU microcode. A stale <vendor>-ucode.img left on a reused ESP makes a
    # plain install fail with "exists in filesystem" (a file conflict retries
    # can't fix), silently skipping microcode. --overwrite lets the package
    # claim the file it legitimately owns; retry fallback covers mirror blips.
    case "$CPU_VENDOR" in
        amd)
            arch-chroot /mnt pacman -S --noconfirm --needed --overwrite '/boot/amd-ucode.img' amd-ucode \
                || pac_install_retry amd-ucode || warn "amd-ucode not installed - CPU microcode updates unavailable" ;;
        intel)
            arch-chroot /mnt pacman -S --noconfirm --needed --overwrite '/boot/intel-ucode.img' intel-ucode \
                || pac_install_retry intel-ucode || warn "intel-ucode not installed - CPU microcode updates unavailable" ;;
    esac

    # CoreCtrl for AMD GPU control
    [[ "$GPU_VENDOR" == "amd" ]] && \
        pac_install_retry corectrl || true

    log "All packages installed"
}

# -- System configuration + tweaks ----------------------------
configure_system() {
    hr "System Configuration"
    log "Generating fstab..."
    genfstab -U /mnt >> /mnt/etc/fstab || err "genfstab failed"
    grep -qE '^[^#].*[[:space:]]/[[:space:]]+btrfs' /mnt/etc/fstab \
        || err "fstab has no btrfs root entry - check the log"

    # /tmp: no fstab entry on purpose. systemd's tmp.mount already makes /tmp a
    # tmpfs (nosuid,nodev, sized at 50% of RAM). A fixed size cap here would
    # override that and break large builds/extractions on high-RAM machines.

    # (mkinitcpio.conf written and rebuilt by rebuild_initramfs after all packages)

    # -- Sysctl tuning ----------------------------------------
    # Swap here is ZRAM (compressed RAM), not disk - so classic low-swappiness
    # tuning is inverted: it makes the kernel drop useful page cache instead of
    # using nearly-free compressed memory. swappiness=100 matches CachyOS's
    # shipped default for this exact stack. page-cluster=0 reads one page per
    # fault instead of eight - right for RAM-backed swap, a legacy of spinning
    # disks otherwise.
    local swappiness=100

    cat > /mnt/etc/sysctl.d/99-niixarch.conf <<SYSEOF
vm.swappiness=$swappiness
vm.page-cluster=0
vm.vfs_cache_pressure=50
vm.compaction_proactiveness=0
vm.watermark_boost_factor=0
vm.max_map_count=2147483642
kernel.nmi_watchdog=0
kernel.split_lock_mitigate=0
fs.inotify.max_user_watches=524288
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
SYSEOF
    # No global ip_forward: NetworkManager switches IPv4 forwarding on itself
    # while a shared (hotspot) connection is up. Global IPv6 forwarding would
    # also make the kernel ignore router advertisements on every interface.
    log "Sysctl tuned (ZRAM-aware swap: swappiness=$swappiness + page-cluster=0; max_map_count + split-lock for gaming)"

    # -- Transparent hugepages --------------------------------
    mkdir -p /mnt/etc/tmpfiles.d
    echo "w /sys/kernel/mm/transparent_hugepage/enabled - - - - madvise" \
        > /mnt/etc/tmpfiles.d/hugepages.conf

    # -- NVMe I/O scheduler -----------------------------------
    if [[ "$HAS_NVME" == true ]]; then
        mkdir -p /mnt/etc/udev/rules.d
        echo 'ACTION=="add|change", KERNEL=="nvme[0-9]n[0-9]", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="none"' \
            > /mnt/etc/udev/rules.d/60-nvme-scheduler.conf
    fi

    # -- SSD I/O scheduler ------------------------------------
    if [[ "$HAS_SSD" == true ]]; then
        mkdir -p /mnt/etc/udev/rules.d
        echo 'ACTION=="add|change", KERNEL=="sd[a-z]", ATTR{queue/rotational}=="0", ATTR{queue/scheduler}="none"' \
            > /mnt/etc/udev/rules.d/60-ssd-scheduler.conf
    fi

    # -- ZRAM (auto-sized) ------------------------------------
    local zram_frac="ram / 2"
    [[ "$MEM_TOTAL_GB" -le 8 ]] && zram_frac="ram"
    cat > /mnt/etc/systemd/zram-generator.conf <<ZRAMEOF
[zram0]
zram-size = $zram_frac
compression-algorithm = zstd
ZRAMEOF

    # -- Firewall (configure rules - ufw starts on boot via systemctl) --
    # NetworkManager connection-sharing (hotspot) hands out 10.42.0.0/24 and
    # runs its own per-interface dnsmasq. ufw's default "deny incoming" blocks
    # the phone's DHCP (67/udp) + DNS (53) requests, and the default DROP
    # forward policy blocks its traffic - so the phone connects but gets no IP
    # or no internet. The rules below open exactly that: DHCP/DNS from the
    # hotspot subnet, and forwarding ONLY for traffic originating from it
    # (replies are already allowed by ufw's conntrack rules). The global
    # forward policy stays DROP.
    arch-chroot /mnt bash <<'FWEOF'
ufw default deny incoming 2>/dev/null || true
ufw default allow outgoing 2>/dev/null || true
ufw default deny routed 2>/dev/null || true
# Steam (in-home streaming / remote play)
ufw allow 27036:27037/tcp 2>/dev/null || true
ufw allow 27031:27036/udp 2>/dev/null || true
# Hotspot: let clients on the shared subnet pull DHCP + DNS from us
ufw allow in proto udp from 10.42.0.0/24 to any port 67 2>/dev/null || true
ufw allow in proto udp from 10.42.0.0/24 to any port 53 2>/dev/null || true
ufw allow in proto tcp from 10.42.0.0/24 to any port 53 2>/dev/null || true
ufw route allow from 10.42.0.0/24 2>/dev/null || true
# Don't run 'ufw --force enable' in chroot - no iptables modules
# ufw will start on boot via systemctl enable ufw
FWEOF

    grep -qs '10.42.0.0/24' /mnt/etc/ufw/user.rules \
        || warn "ufw hotspot rules were not written - the hotspot may not hand out addresses"

    # -- niix-hotspot helper - phone-friendly 2.4GHz WPA2 hotspot ---------
    # Defaults to 2.4GHz / channel 7 / WPA2-AES only. This is the combination
    # phones reliably connect to: 5GHz AP mode fails on many adapters, WPA3/SAE
    # is rejected by older phones, and TKIP is rejected by newer ones.
    cat > /mnt/usr/local/bin/niix-hotspot <<'HSEOF'
#!/bin/bash
# niix-hotspot - phone-friendly 2.4GHz WPA2 Wi-Fi hotspot (NetworkManager)
#   niix-hotspot start [SSID] [PASSWORD]  create/update the hotspot and bring it up
#   niix-hotspot setup SSID [PASSWORD]    create/update it without bringing it up
#   niix-hotspot up                       bring the saved hotspot up
#   niix-hotspot stop                     take it down (auto mode paused until reboot)
#   niix-hotspot auto on|off              keep it up automatically (from boot, and
#                                         restored after internet outages)
#   niix-hotspot password                 show the saved password
#   niix-hotspot status
# PASSWORD: 8-63 characters; omit it to get a random one. It is stored only in
# NetworkManager's root-only profile. Defaults: 2.4GHz, channel 7, WPA2-AES
# only - the combination phones connect to most reliably.
# Exit codes: 0 ok, 1 error, 2 refused (Wi-Fi is the only internet connection),
#             3 no saved hotspot
set -uo pipefail
CON="niix-hotspot"
SVC="niix-hotspot-watchdog.service"
ACTION="${1:-}"

usage() {
    echo "Usage: niix-hotspot {start [SSID] [PASSWORD]|setup SSID [PASSWORD]|up|stop|auto on|off|password|status}"
}

run_root() {
    if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo "$@"; fi
}

wifi_dev() {
    nmcli -t -f DEVICE,TYPE device 2>/dev/null | awk -F: '$2=="wifi"{print $1; exit}'
}

have_profile() {
    nmcli connection show "$CON" >/dev/null 2>&1
}

hotspot_active() {
    [ "$(nmcli -g GENERAL.STATE connection show "$CON" 2>/dev/null)" = "activated" ]
}

random_pass() {
    local p
    p=$(tr -dc 'A-Za-z0-9' < /dev/urandom 2>/dev/null | head -c 16) || true
    printf '%s' "$p"
}

# One Wi-Fi card cannot be a client and an access point at the same time. If
# Wi-Fi is the ONLY internet connection, turning it into a hotspot would cut
# this machine off and leave nothing to share - refuse unless another uplink
# (Ethernet, USB tethering, mobile modem) is up. NIIX_HOTSPOT_FORCE=1 overrides.
uplink_ok() {
    local dev="$1" state conn other
    [ "${NIIX_HOTSPOT_FORCE:-0}" = "1" ] && return 0
    state=$(nmcli -t -f DEVICE,STATE device 2>/dev/null | awk -F: -v d="$dev" '$1==d{print $2; exit}')
    conn=$(nmcli -g GENERAL.CONNECTION device show "$dev" 2>/dev/null)
    [ "$state" = "connected" ] && [ "$conn" != "$CON" ] || return 0
    other=$(nmcli -t -f DEVICE,TYPE,STATE device 2>/dev/null | awk -F: -v d="$dev" \
        '$1!=d && $3=="connected" && $2!~/^(wifi|wifi-p2p|loopback|tun|wireguard|dummy|bridge)$/ {print $1; exit}')
    [ -n "$other" ] && return 0
    echo "Wi-Fi $dev is your internet connection ('$conn')."
    echo "A hotspot on the same Wi-Fi card would disconnect you and share nothing."
    echo "Connect Ethernet or USB tethering first - or force it: NIIX_HOTSPOT_FORCE=1 niix-hotspot up"
    return 1
}

create_profile() {
    local ssid="$1" pass="$2" dev
    dev=$(wifi_dev)
    [ -n "$dev" ] || { echo "No Wi-Fi device found."; return 1; }
    local ssid_bytes
    ssid_bytes=$(printf '%s' "$ssid" | wc -c)
    if [ "$ssid_bytes" -lt 1 ] || [ "$ssid_bytes" -gt 32 ]; then
        echo "SSID must be 1-32 bytes."; return 1
    fi
    if [ "${#pass}" -lt 8 ] || [ "${#pass}" -gt 63 ]; then
        echo "Password must be 8-63 characters."; return 1
    fi
    nmcli connection delete "$CON" >/dev/null 2>&1 || true
    nmcli connection add type wifi ifname "$dev" con-name "$CON" \
        autoconnect no ssid "$ssid" \
        802-11-wireless.mode ap \
        802-11-wireless.band bg \
        802-11-wireless.channel 7 \
        802-11-wireless.powersave 2 \
        ipv4.method shared \
        ipv6.method ignore \
        wifi-sec.key-mgmt wpa-psk \
        wifi-sec.proto rsn \
        wifi-sec.pairwise ccmp \
        wifi-sec.group ccmp \
        wifi-sec.pmf optional \
        wifi-sec.psk "$pass" >/dev/null \
        || { echo "Could not create the hotspot profile."; return 1; }
}

bring_up() {
    local dev bound ssid
    have_profile || { echo "No saved hotspot - run: niix-hotspot start [SSID] [PASSWORD]"; return 3; }
    dev=$(wifi_dev)
    [ -n "$dev" ] || { echo "No Wi-Fi device found."; return 1; }
    # Keep the profile bound to the current Wi-Fi card (names can change,
    # e.g. a different USB adapter).
    bound=$(nmcli -g connection.interface-name connection show "$CON" 2>/dev/null)
    if [ "$bound" != "$dev" ]; then
        nmcli connection modify "$CON" connection.interface-name "$dev" >/dev/null 2>&1 || true
    fi
    uplink_ok "$dev" || return 2
    if ! nmcli connection up "$CON" >/dev/null 2>&1; then
        echo "Failed to start hotspot. Check: nmcli -f WIFI-PROPERTIES.AP device show $dev"
        return 1
    fi
    ssid=$(nmcli -g 802-11-wireless.ssid connection show "$CON" 2>/dev/null)
    echo "Hotspot '$ssid' is UP on $dev (2.4GHz, WPA2-AES)."
    return 0
}

# Turn on auto mode: the hotspot comes up at every boot and is restored after
# an internet outage. Used by 'auto on' AND by 'start', so enabling the hotspot
# later behaves exactly like choosing it during first boot.
enable_auto() {
    have_profile || { echo "Set up the hotspot first: niix-hotspot setup SSID [PASSWORD]"; return 3; }
    # The dispatcher runs the hook that wakes the keeper on network events.
    run_root systemctl enable --now NetworkManager-dispatcher.service >/dev/null 2>&1 \
        || echo "Note: could not enable NetworkManager-dispatcher - the hotspot still recovers, just on the 15s timer."
    if run_root systemctl enable --now "$SVC"; then
        echo "Auto hotspot ON: kept up from boot and restored after internet outages."
        return 0
    fi
    echo "Could not enable $SVC - the hotspot will not come back after a reboot." >&2
    return 1
}

# setup/start argument handling: SSID defaults to NiiX-Arch; a missing
# password is generated randomly and printed once.
prepare_profile() {
    local ssid="${1:-NiiX-Arch}" pass="${2:-}" generated=false
    if [ -z "$pass" ]; then
        pass=$(random_pass)
        generated=true
    fi
    create_profile "$ssid" "$pass" || return 1
    echo "Hotspot saved: SSID '$ssid'"
    if [ "$generated" = true ]; then
        echo "Generated password: $pass  (show it again any time: niix-hotspot password)"
    fi
    return 0
}

case "$ACTION" in
    start)
        if [ $# -ge 2 ] || ! have_profile; then
            prepare_profile "${2:-}" "${3:-}" || exit 1
        fi
        bring_up; rc=$?
        if [ "$rc" -eq 0 ]; then
            if systemctl is-enabled --quiet "$SVC" 2>/dev/null; then
                # Resume auto mode if it is enabled but was paused by 'stop'.
                systemctl is-active --quiet "$SVC" 2>/dev/null \
                    || systemctl start "$SVC" >/dev/null 2>&1 || true
            elif [ "${NIIX_HOTSPOT_ONCE:-0}" != "1" ]; then
                # Setting the hotspot up later must give the same result as
                # choosing it during first boot: on at every boot, with the same
                # connectivity checks. NIIX_HOTSPOT_ONCE=1 starts it just once.
                echo "Turning on auto mode so the hotspot also comes back after a reboot..."
                enable_auto || true
            fi
        fi
        exit "$rc"
        ;;
    setup)
        [ $# -ge 2 ] || { usage; exit 1; }
        prepare_profile "$2" "${3:-}" || exit 1
        ;;
    up)
        bring_up; exit $?
        ;;
    stop)
        if systemctl is-active --quiet "$SVC" 2>/dev/null; then
            if systemctl stop "$SVC" >/dev/null 2>&1; then
                echo "Auto mode paused until the next boot ('niix-hotspot start' resumes it, 'niix-hotspot auto off' disables it)."
            else
                echo "Could not pause auto mode - it will bring the hotspot back. Try: sudo niix-hotspot stop"
            fi
        fi
        nmcli connection down "$CON" >/dev/null 2>&1 || true
        echo "Hotspot stopped."
        ;;
    auto)
        case "${2:-}" in
            on)
                enable_auto || exit $? ;;
            off)
                run_root systemctl disable --now "$SVC" \
                    && echo "Auto hotspot OFF." ;;
            *)
                auto_state=$(systemctl is-enabled "$SVC" 2>/dev/null) || true
                echo "Auto hotspot: ${auto_state:-unknown}"
                echo "Usage: niix-hotspot auto on|off" ;;
        esac
        ;;
    password)
        have_profile || { echo "No saved hotspot."; exit 3; }
        nmcli -s -g 802-11-wireless-security.psk connection show "$CON" 2>/dev/null \
            || { echo "Could not read the password (try: sudo niix-hotspot password)"; exit 1; }
        ;;
    status)
        if hotspot_active; then
            echo "Hotspot: UP ('$(nmcli -g 802-11-wireless.ssid connection show "$CON" 2>/dev/null)')"
        elif have_profile; then
            echo "Hotspot: down (saved as '$(nmcli -g 802-11-wireless.ssid connection show "$CON" 2>/dev/null)')"
        else
            echo "Hotspot: not set up - run: niix-hotspot start [SSID] [PASSWORD]"
        fi
        auto_state=$(systemctl is-enabled "$SVC" 2>/dev/null) || true
        run_state=$(systemctl is-active "$SVC" 2>/dev/null) || true
        echo "Auto mode: ${auto_state:-unknown} (${run_state:-unknown})"
        ;;
    *) usage; exit 1 ;;
esac
HSEOF
    chmod 755 /mnt/usr/local/bin/niix-hotspot

    # -- Hotspot keeper (auto mode) --------------------------------------
    # A root system service owns the logic: internet checked every 120s
    # (every 5s while offline) against two independent endpoints; hotspot
    # checked every 15s and restored once the internet is back. A
    # NetworkManager dispatcher hook wakes it instantly on network events.
    # Runs from boot (no login needed). Disabled until the user opts in
    # (first-boot prompt, or: niix-hotspot auto on).
    cat > /mnt/usr/local/bin/niix-hotspot-watchdog <<'HSWEOF'
#!/bin/bash
# niix-hotspot-watchdog - keeps the NiiX Wi-Fi hotspot up (system service, root).
#   Internet: HTTP checks of two independent endpoints - online if EITHER
#             answers correctly (a captive portal fails both). Every 120s
#             while online, every 5s while offline.
#   Hotspot:  checked every 15s, and immediately on NetworkManager events
#             (the dispatcher hook sends SIGUSR1). When it is found down the
#             internet is re-checked on the spot; if online, 'niix-hotspot up'
#             brings it back - which itself
#             refuses to take over Wi-Fi when Wi-Fi is the only internet.
#   While offline the hotspot is left as it is, so phones stay associated.
# Logs: journalctl -u niix-hotspot-watchdog -f
set -u

ONLINE_INTERVAL=120
OFFLINE_INTERVAL=5
HOTSPOT_INTERVAL=15

probe_gnome() {
    local body
    body=$(curl -fsS --connect-timeout 3 --max-time 5 \
        http://nmcheck.gnome.org/check_network_status.txt 2>/dev/null) || return 1
    [ "$body" = "NetworkManager is online" ]
}

probe_google() {
    local code
    code=$(curl -sS -o /dev/null -w '%{http_code}' --connect-timeout 3 --max-time 5 \
        http://www.gstatic.com/generate_204 2>/dev/null) || return 1
    [ "$code" = "204" ]
}

internet_ok() {
    probe_gnome || probe_google
}

hotspot_active() {
    [ "$(nmcli -g GENERAL.STATE connection show niix-hotspot 2>/dev/null)" = "activated" ]
}

WAKE=0
SLEEP_PID=""
trap 'WAKE=1' USR1
trap '[ -n "$SLEEP_PID" ] && kill "$SLEEP_PID" 2>/dev/null; exit 0' TERM INT

# Interruptible sleep: SIGUSR1 (a NetworkManager event) ends it early.
nap() {
    sleep "$1" &
    SLEEP_PID=$!
    wait "$SLEEP_PID" 2>/dev/null
    kill "$SLEEP_PID" 2>/dev/null
    wait "$SLEEP_PID" 2>/dev/null
    SLEEP_PID=""
}

online=unknown
next_probe=0
last_probe=-1000
last_rc=""
echo "started: internet check every ${ONLINE_INTERVAL}s (every ${OFFLINE_INTERVAL}s while offline), hotspot every ${HOTSPOT_INTERVAL}s"

while true; do
    if [ "$WAKE" -eq 1 ]; then
        WAKE=0
        next_probe=0
    fi

    now=$(date +%s)
    hotspot_up=true
    hotspot_active || hotspot_up=false

    # Probe when due - and also right away whenever the hotspot is found down,
    # so the decision to bring it back never rests on a stale "online".
    if [ "$now" -ge "$next_probe" ] \
        || { [ "$hotspot_up" = false ] && [ $(( now - last_probe )) -ge "$OFFLINE_INTERVAL" ]; }; then
        last_probe=$now
        if internet_ok; then
            [ "$online" != true ] && echo "internet: online"
            online=true
            next_probe=$(( $(date +%s) + ONLINE_INTERVAL ))
        else
            [ "$online" != false ] && echo "internet: OFFLINE - re-checking every ${OFFLINE_INTERVAL}s"
            online=false
            next_probe=$(( $(date +%s) + OFFLINE_INTERVAL ))
        fi
    fi

    if [ "$online" = true ] && [ "$hotspot_up" = false ]; then
        niix-hotspot up >/dev/null 2>&1
        rc=$?
        if [ "$rc" -eq 0 ]; then
            echo "hotspot: brought up"
            last_rc=""
        elif [ "$rc" != "$last_rc" ]; then
            case "$rc" in
                2) echo "hotspot: waiting - Wi-Fi is the only internet connection (connect Ethernet or USB tethering)" ;;
                3) echo "hotspot: no saved hotspot - run 'niix-hotspot start' once" ;;
                *) echo "hotspot: failed to come up (rc=$rc) - retrying every ${HOTSPOT_INTERVAL}s" ;;
            esac
            last_rc="$rc"
        fi
    fi

    wait_s=$(( next_probe - $(date +%s) ))
    [ "$wait_s" -gt "$HOTSPOT_INTERVAL" ] && wait_s=$HOTSPOT_INTERVAL
    [ "$wait_s" -lt 1 ] && wait_s=1
    [ "$WAKE" -eq 1 ] || nap "$wait_s"
done
HSWEOF
    chmod 755 /mnt/usr/local/bin/niix-hotspot-watchdog

    cat > /mnt/etc/systemd/system/niix-hotspot-watchdog.service <<'HSUNITEOF'
[Unit]
Description=NiiX Wi-Fi hotspot keeper (kept up from boot, restored after internet outages)
Wants=NetworkManager.service
After=NetworkManager.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/niix-hotspot-watchdog
Restart=always
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
HSUNITEOF

    # NetworkManager only runs dispatcher scripts that are root-owned,
    # executable and not writable by group/others.
    mkdir -p /mnt/etc/NetworkManager/dispatcher.d
    cat > /mnt/etc/NetworkManager/dispatcher.d/90-niix-hotspot <<'HSDISPEOF'
#!/bin/sh
# Wake the hotspot keeper immediately on network changes instead of waiting
# for its next scheduled check. No-op when auto mode is off.
case "$2" in
    up|down|connectivity-change)
        systemctl kill --kill-whom=main --signal=USR1 niix-hotspot-watchdog.service >/dev/null 2>&1 || true
        ;;
esac
exit 0
HSDISPEOF
    chown root:root /mnt/etc/NetworkManager/dispatcher.d/90-niix-hotspot
    chmod 755 /mnt/etc/NetworkManager/dispatcher.d/90-niix-hotspot

    # 'niix-hotspot stop' pauses auto mode and 'start' resumes it: let the
    # active local wheel user start/stop/restart THIS one unit without a
    # password prompt (enable/disable still needs sudo).
    mkdir -p /mnt/etc/polkit-1/rules.d
    cat > /mnt/etc/polkit-1/rules.d/92-niix-hotspot.rules <<'HSPOLEOF'
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "niix-hotspot-watchdog.service" &&
        (action.lookup("verb") == "start" ||
         action.lookup("verb") == "stop" ||
         action.lookup("verb") == "restart") &&
        subject.local == true && subject.active == true &&
        subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
HSPOLEOF
    log "niix-hotspot installed (run: niix-hotspot start; auto mode: niix-hotspot auto on)"

    # -- NetworkManager configuration ------------------------
    mkdir -p /mnt/etc/NetworkManager/conf.d

    # Use systemd-resolved for DNS - stops NM from fighting with dnsmasq
    # (dnsmasq is installed for hotspot support but must not be the global DNS)
    cat > /mnt/etc/NetworkManager/conf.d/10-dns.conf <<'NMEOF'
[main]
dns=systemd-resolved
systemd-resolved=true
NMEOF

    # Connectivity check - fixes the ? icon on WiFi, confirms internet is up
    cat > /mnt/etc/NetworkManager/conf.d/20-connectivity.conf <<'CONNEOF'
[connectivity]
uri=http://nmcheck.gnome.org/check_network_status.txt
response=NetworkManager is online
interval=300
CONNEOF

    # WiFi MAC randomization - scoped to WiFi only so Ethernet stays stable
    cat > /mnt/etc/NetworkManager/conf.d/30-wifi-privacy.conf <<'MACEOF'
[device]
match-device=type:wifi
wifi.scan-rand-mac-address=yes

[connection]
match-device=type:wifi
wifi.cloned-mac-address=random
connection.stable-id=${CONNECTION}/${BOOT}
MACEOF

    # Ethernet stability - prevents NM from aborting DHCP during link negotiation
    cat > /mnt/etc/NetworkManager/conf.d/40-ethernet.conf <<'ETHEOF'
[device]
match-device=type:ethernet
ethernet.wake-on-lan=ignore
ETHEOF

    # -- Import WiFi credentials from live ISO (iwd -> NM keyfile) ----------
    # The Arch live ISO uses iwd for WiFi. If the user connected via iwctl,
    # their credentials are in /var/lib/iwd/<SSID>.psk on the live system.
    # We convert them to NM keyfiles so the installed system auto-connects
    # on first boot - without ever installing iwd (it conflicts with wpa_supplicant).
    # Safe to skip: if no .psk files exist (ethernet-only install), nothing happens.
    mkdir -p /mnt/etc/NetworkManager/system-connections

    IWD_DIR="/var/lib/iwd"
    if compgen -G "${IWD_DIR}/*.psk" > /dev/null 2>&1; then
        info "Found iwd WiFi profiles - importing into NetworkManager..."
        local imported=0
        for psk_file in "${IWD_DIR}"/*.psk; do
            [[ -f "$psk_file" ]] || continue

            # iwd names the file after the SSID only when it is letters,
            # digits, space, '-' or '_'; any other SSID is stored as
            # "=<hex of the raw bytes>". Decode both forms, and write the SSID
            # into the NM keyfile as a byte list, which NM always reads back
            # exactly - no escaping rules for quotes, ';' or accents.
            local base ssid_info ssid_bytes ssid_label
            base=$(basename "$psk_file" .psk)
            if ! ssid_info=$(python3 - "$base" <<'SSIDPY'
import sys
base = sys.argv[1]
try:
    raw = bytes.fromhex(base[1:]) if base.startswith("=") else base.encode("utf-8")
except ValueError:
    sys.exit(1)
if not 1 <= len(raw) <= 32:
    sys.exit(1)
print(";".join(str(b) for b in raw) + ";")
label = "".join(c if (c.isalnum() or c in " -_.") else "_" for c in raw.decode("utf-8", "replace")).strip(" .")
print(label or "wifi")
SSIDPY
            ); then
                warn "iwd profile '$base' has an unreadable network name - skipping"
                continue
            fi
            ssid_bytes=${ssid_info%%$'\n'*}
            ssid_label=${ssid_info#*$'\n'}

            # Read the credential - iwd uses either PreSharedKey= (64-char hex)
            # or Passphrase= (human-readable). NM accepts both in psk=. The
            # value is copied verbatim: iwd and NM keyfiles escape the same way.
            local psk_value=""
            local psk_line
            psk_line=$(grep -m1 "^PreSharedKey=" "$psk_file" 2>/dev/null || true)
            if [[ -n "$psk_line" ]]; then
                psk_value="${psk_line#PreSharedKey=}"
            else
                local pass_line
                pass_line=$(grep -m1 "^Passphrase=" "$psk_file" 2>/dev/null || true)
                [[ -n "$pass_line" ]] && psk_value="${pass_line#Passphrase=}"
            fi

            if [[ -z "$psk_value" ]]; then
                warn "iwd profile '$ssid_label' has no PSK or Passphrase - skipping"
                continue
            fi

            # File name: the readable label, made unique.
            local nm_file n=1
            nm_file="/mnt/etc/NetworkManager/system-connections/${ssid_label}.nmconnection"
            while [[ -e "$nm_file" ]]; do
                n=$(( n + 1 ))
                nm_file="/mnt/etc/NetworkManager/system-connections/${ssid_label}-${n}.nmconnection"
            done

            # umask 077: the file holds the Wi-Fi password and must never
            # exist world-readable, not even for a moment. NM also ignores
            # keyfiles that are not 0600 root-owned.
            (
                umask 077
                cat > "$nm_file" <<NMWIFI
[connection]
id=${ssid_label}
type=wifi
autoconnect=true

[wifi]
ssid=${ssid_bytes}
mode=infrastructure

[wifi-security]
key-mgmt=wpa-psk
psk=${psk_value}

[ipv4]
method=auto

[ipv6]
method=auto
addr-gen-mode=stable-privacy
NMWIFI
            )
            chmod 600 "$nm_file"

            log "WiFi imported: '$ssid_label' -> $(basename "$nm_file")"
            imported=$(( imported + 1 ))
        done
        [[ "$imported" -eq 0 ]] && warn "iwd profiles found but none could be imported"             || log "$imported WiFi profile(s) imported - will auto-connect on first boot"
    else
        info "No iwd WiFi profiles found (ethernet or WiFi not used during install) - skipping"
    fi

    # -- Also copy any live NetworkManager connections to the target ------
    # The NiiX live ISO uses NetworkManager, so WiFi joined during pre-flight
    # is stored here rather than in iwd. Copy the profiles across so the
    # installed system auto-connects on first boot too.
    if compgen -G "/etc/NetworkManager/system-connections/*.nmconnection" > /dev/null 2>&1; then
        info "Copying live NetworkManager connections to the target..."
        local nmcopied=0 src base dst
        for src in /etc/NetworkManager/system-connections/*.nmconnection; do
            [ -f "$src" ] || continue
            base=$(basename "$src")
            dst="/mnt/etc/NetworkManager/system-connections/$base"
            [ -e "$dst" ] && continue
            if cp "$src" "$dst" 2>/dev/null; then
                chmod 600 "$dst"
                nmcopied=$(( nmcopied + 1 ))
            fi
        done
        [ "$nmcopied" -gt 0 ] \
            && log "$nmcopied NetworkManager connection(s) copied - target will auto-connect" \
            || info "No new NetworkManager connections to copy"
    fi

    # -- systemd-resolved DNS config -------------------------
    # Keep it simple - no DNSSEC/DoT which can silently break resolution
    # on many home/corporate networks. Cloudflare as primary, Quad9 fallback.
    mkdir -p /mnt/etc/systemd/resolved.conf.d
    cat > /mnt/etc/systemd/resolved.conf.d/dns.conf <<'DNSEOF'
[Resolve]
DNS=1.1.1.1 1.0.0.1
FallbackDNS=9.9.9.9 149.112.112.112
DNSSEC=no
DNSOverTLS=no
DNSEOF

    # (LAVD scheduler set up during first-boot with CachyOS kernel)

    # -- ntsync module ----------------------------------------
    mkdir -p /mnt/etc/modules-load.d
    echo "ntsync" > /mnt/etc/modules-load.d/ntsync.conf

    # -- Auto-update timer ------------------------------------
    # Skip this run entirely if a game/launcher process looks active - an
    # unattended pacman -Syu mid-session can replace libs/binaries out from
    # under a running game. ExecStartPre failing just skips this cycle; the
    # timer tries again at the next 12h interval.
    cat > /mnt/usr/local/bin/niix-update-gate <<'GATEEOF'
#!/bin/bash
for p in steam steamwebhelper lutris heroic wine64-preloader wineserver \
         retroarch gamescope; do
    if pgrep -ix "$p" >/dev/null 2>&1; then
        echo "NiiX update gate: '$p' is running - skipping this update cycle"
        exit 1
    fi
done
exit 0
GATEEOF
    chmod +x /mnt/usr/local/bin/niix-update-gate

    cat > /mnt/etc/systemd/system/niixarch-update.service <<'UPDEOF'
[Unit]
Description=NiiX Arch System Update
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStartPre=/usr/local/bin/niix-update-gate
ExecStart=/usr/bin/pacman -Syu --noconfirm
UPDEOF

    cat > /mnt/etc/systemd/system/niixarch-update.timer <<'TMREOF'
[Unit]
Description=NiiX Arch Update Timer (every 12h)

[Timer]
OnBootSec=15min
OnUnitActiveSec=12h
Persistent=true
RandomizedDelaySec=30min

[Install]
WantedBy=timers.target
TMREOF

    # -- CoreCtrl polkit (AMD only) ---------------------------
    if [[ "$GPU_VENDOR" == "amd" ]]; then
        mkdir -p /mnt/etc/polkit-1/rules.d
        cat > /mnt/etc/polkit-1/rules.d/90-corectrl.rules <<'POLEOF'
polkit.addRule(function(action, subject) {
    if ((action.id == "org.corectrl.helper.init" ||
         action.id == "org.corectrl.helperkiller.init") &&
        subject.local == true && subject.active == true &&
        subject.isInGroup("wheel")) { return polkit.Result.YES; }
});
POLEOF
    fi

    # -- NetworkManager polkit (hotspot) -----------------------
    # org.freedesktop.NetworkManager.settings.modify.system defaults to
    # auth_admin_keep, which pops an interactive polkit prompt. niix-hotspot
    # creates/activates a system-wide connection, and the watchdog service
    # runs headless with no polkit agent to answer that prompt - without this
    # rule it would silently fail every time (nmcli errors get swallowed by
    # the watchdog's >/dev/null 2>&1). Scoped to the active local wheel user.
    mkdir -p /mnt/etc/polkit-1/rules.d
    cat > /mnt/etc/polkit-1/rules.d/91-niix-networkmanager.rules <<'POLEOF'
polkit.addRule(function(action, subject) {
    if (action.id.indexOf("org.freedesktop.NetworkManager.") == 0 &&
        subject.local == true && subject.active == true &&
        subject.isInGroup("wheel")) { return polkit.Result.YES; }
});
POLEOF

    # -- Configure + enable services in chroot ----------------
    # Quoted heredoc: nothing in the body is expanded by THIS shell, so a '$' or
    # backtick added later can never be evaluated at the wrong layer. Values are
    # passed in explicitly through the environment instead.
    log "Configuring system in chroot..."
    arch-chroot /mnt env \
        NX_TIMEZONE="$TIMEZONE" NX_LOCALE="$LOCALE" \
        NX_KEYMAP="$KEYMAP" NX_HOSTNAME="$HOSTNAME" \
        bash <<'CHROOT'
set -e

ln -sf "/usr/share/zoneinfo/${NX_TIMEZONE}" /etc/localtime
hwclock --systohc

grep -qxF "${NX_LOCALE} UTF-8" /etc/locale.gen || echo "${NX_LOCALE} UTF-8" >> /etc/locale.gen
grep -qxF "en_US.UTF-8 UTF-8" /etc/locale.gen || echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen
locale-gen
echo "LANG=${NX_LOCALE}" > /etc/locale.conf

echo "KEYMAP=${NX_KEYMAP}" > /etc/vconsole.conf

echo "${NX_HOSTNAME}" > /etc/hostname
cat > /etc/hosts <<EOF
127.0.0.1   localhost
::1         localhost
127.0.1.1   ${NX_HOSTNAME}.localdomain ${NX_HOSTNAME}
EOF

# Grant the wheel group sudo via a drop-in (safer than editing /etc/sudoers in
# place) and validate it with visudo before it can take effect.
install -d -m 750 /etc/sudoers.d
printf '%%wheel ALL=(ALL:ALL) ALL\n' > /etc/sudoers.d/10-wheel
chmod 440 /etc/sudoers.d/10-wheel
visudo -cf /etc/sudoers.d/10-wheel \
    || { echo "FATAL: generated sudoers drop-in failed validation"; rm -f /etc/sudoers.d/10-wheel; exit 1; }

# -- Critical networking services - these MUST succeed ----
# Placed first, before set -e can be triggered by anything else.
# If these fail the system will have no network after boot.
# NOTE: wpa_supplicant.service is intentionally NOT enabled here - NM spawns
# its own per-interface wpa_supplicant instance, and a system-wide service
# competing for the same interface causes "supplicant interface failed"
# conflicts. The wpa_supplicant package is still installed (NM links against
# it), it just shouldn't be a separately-enabled unit.
systemctl enable NetworkManager
systemctl enable systemd-resolved

# -- resolv.conf -> systemd-resolved stub ------------------
# arch-chroot bind-mounts the live ISO's resolv.conf over this file, and a
# bind-mount target can't be removed (EBUSY) - drop the mount first.
# Then rm -f: ln -sf will NOT overwrite a regular file on all kernels.
umount /etc/resolv.conf 2>/dev/null || true
rm -f /etc/resolv.conf 2>/dev/null || true
ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf

# -- Bluetooth - BlueZ daemon configuration ----------------
# Experimental=true  -> battery percentage of headsets shows up in GNOME.
# ControllerMode=dual -> classic + LE on the same adapter (LE Audio headsets).
# FastConnectable    -> quicker reconnect when a paired headset powers on.
# AutoEnable         -> adapter is powered at boot; no "turn BT on every boot".
cat > /etc/bluetooth/main.conf <<'BTMAINEOF'
[General]
ControllerMode = dual
FastConnectable = true
Experimental = true

[Policy]
AutoEnable = true
BTMAINEOF

# -- Optional services - || true so a missing package can't kill the chroot --
systemctl enable ananicy-cpp           2>/dev/null || true
systemctl enable irqbalance            2>/dev/null || true
systemctl enable ufw                   2>/dev/null || true
systemctl enable power-profiles-daemon 2>/dev/null || true
systemctl enable niixarch-update.timer 2>/dev/null || true
systemctl enable bluetooth             2>/dev/null || true
systemctl enable iio-sensor-proxy      2>/dev/null || true
systemctl enable fstrim.timer          2>/dev/null || true
# Runs /etc/NetworkManager/dispatcher.d hooks (wakes the hotspot keeper on network events)
systemctl enable NetworkManager-dispatcher.service 2>/dev/null || true
systemctl disable NetworkManager-wait-online.service 2>/dev/null || true
# Mask the standalone dnsmasq service: NetworkManager runs its OWN per-interface
# dnsmasq for the hotspot. A system-wide dnsmasq on port 53 would conflict and
# break the hotspot's DHCP/DNS. The binary stays installed for NM to use.
systemctl mask dnsmasq                  2>/dev/null || true

# -- Snapper - Btrfs snapshot management ------------------
# snap-pac auto-creates pre/post snapshots on every pacman transaction.
# Timeline disabled - only pacman snapshots, last 10 kept.
mkdir -p /etc/snapper/configs
cat > /etc/snapper/configs/root <<'SNAPEOF'
SUBVOLUME="/"
FSTYPE="btrfs"
ALLOW_USERS=""
ALLOW_GROUPS=""
SYNC_ACL="no"
BACKGROUND_COMPARISON="yes"
NUMBER_CLEANUP="yes"
NUMBER_MIN_AGE="1800"
NUMBER_LIMIT="10"
NUMBER_LIMIT_IMPORTANT="5"
TIMELINE_CREATE="no"
TIMELINE_CLEANUP="no"
EMPTY_PRE_POST_CLEANUP="yes"
EMPTY_PRE_POST_MIN_AGE="1800"
SNAPEOF
# Register the config - on Arch, snapper/snap-pac/snapper-cleanup only act on
# configs listed in SNAPPER_CONFIGS (/etc/conf.d/snapper). A hand-written config
# file alone is invisible to them, so pacman snapshots would never be taken and
# cleanup would never run.
mkdir -p /etc/conf.d
if grep -q '^SNAPPER_CONFIGS=' /etc/conf.d/snapper 2>/dev/null; then
    sed -i 's/^SNAPPER_CONFIGS=.*/SNAPPER_CONFIGS="root"/' /etc/conf.d/snapper
else
    echo 'SNAPPER_CONFIGS="root"' >> /etc/conf.d/snapper
fi
chmod 750 /.snapshots
systemctl enable snapper-cleanup.timer 2>/dev/null || true
# Create the initial clean-install snapshot (pre-firstboot baseline)
snapper --no-dbus -c root create --description "NiiX Arch - clean install" 2>/dev/null || true
CHROOT
    local chroot_rc=$?
    [[ "$chroot_rc" -eq 0 ]] \
        || err "chroot system configuration failed (exit $chroot_rc) - check the log"

    # Hard verification of the one thing a silent failure would hide longest:
    # a system without NetworkManager enabled has no network after first boot.
    [[ -L /mnt/etc/systemd/system/multi-user.target.wants/NetworkManager.service ]] \
        || err "chroot configuration failed - NetworkManager was not enabled. Check the log."

    log "LUKS UUID: $LUKS_UUID"

    # Set passwords and create user (passwords only ever travel over stdin)
    log "Setting passwords..."
    printf '%s\n' "root:${USER_PASS}" | arch-chroot /mnt chpasswd \
        || err "Could not set the root password"
    arch-chroot /mnt useradd -m -G wheel,audio,video,storage,optical \
        -s /bin/bash "${USERNAME}" \
        || err "Could not create user '${USERNAME}'"
    printf '%s\n' "${USERNAME}:${USER_PASS}" | arch-chroot /mnt chpasswd \
        || err "Could not set the password for '${USERNAME}'"

    log "System configured"
}

# -- NiiX logo ------------------------------------------------
# A normal PNG file in the project's GitHub repo - nothing is encoded in this
# script. Purely cosmetic (About page, ArcMenu button): if it cannot be
# fetched, or what arrives is not a PNG, the install carries on without it.
NIIX_LOGO_URL="https://raw.githubusercontent.com/techniixdotcom/niixarch-install/main/niixarch-logo.png"

write_logo() {
    local pixmaps="/mnt/usr/share/pixmaps" brand="/mnt/etc/niixarch" tmp
    mkdir -p "$pixmaps" "$brand"
    tmp=$(mktemp) || { warn "Could not create a temporary file - branding logo skipped"; return 0; }
    if curl -fsSL --retry 3 --max-time 60 --max-filesize 5242880 "$NIIX_LOGO_URL" -o "$tmp" \
        && [[ "$(head -c 8 "$tmp" | od -An -tx1 | tr -d ' \n')" == "89504e470d0a1a0a" ]]; then
        install -m 644 "$tmp" "$pixmaps/niixarch-logo.png"
        install -m 644 "$tmp" "$brand/niixarch-logo.png"
        # GNOME Settings "About" reads the distributor logo named after os-release LOGO=
        install -m 644 "$tmp" "$pixmaps/niixarch.png"
        log "NiiX logo installed (/usr/share/pixmaps/niixarch-logo.png)"
    else
        warn "Could not download the NiiX logo from GitHub - branding logo skipped (nothing else is affected)"
    fi
    rm -f "$tmp"
}

# -- NiiX icon theme ------------------------------------------
